{% extends 'admin/base.html.twig' %}

{% block admin_title %}Candidatures locataires{% endblock %}

{% block admin_body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <h1 class="fw-bold mb-0" style="color: var(--c-text); font-family: var(--f-serif);">
        Candidatures locataires
        {% if stats.pending > 0 %}
            <span class="badge bg-warning text-dark ms-2 rounded-pill" style="font-size: 0.45em; vertical-align: middle;">{{ stats.pending }} en attente</span>
        {% endif %}
    </h1>
</div>

{# Flash messages #}
{% for type, messages in app.flashes %}
    {% for msg in messages %}
        <div class="alert alert-{{ type == 'info' ? 'info' : (type == 'success' ? 'success' : (type == 'danger' ? 'danger' : 'warning')) }} alert-dismissible fade show rounded-3 mb-3" role="alert">
            {{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

{# Stats #}
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="p-3 rounded" style="background: rgba(255,255,255,0.04); border-left: 4px solid #ffc107;">
            <span class="d-block text-white fs-3 fw-bold">{{ stats.pending }}</span>
            <span class="text-warning small">En attente</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 rounded" style="background: rgba(255,255,255,0.04); border-left: 4px solid #198754;">
            <span class="d-block text-white fs-3 fw-bold">{{ stats.accepted }}</span>
            <span class="text-success small">Acceptées</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 rounded" style="background: rgba(255,255,255,0.04); border-left: 4px solid #dc3545;">
            <span class="d-block text-white fs-3 fw-bold">{{ stats.refused }}</span>
            <span class="text-danger small">Refusées</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 rounded" style="background: rgba(255,255,255,0.04); border-left: 4px solid #6c757d;">
            <span class="d-block text-white fs-3 fw-bold">{{ stats.total }}</span>
            <span class="text-muted small">Total</span>
        </div>
    </div>
</div>

{# Filters #}
<div class="d-flex gap-3 align-items-center mb-3 flex-wrap" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 15px;">
    <a href="{{ path('admin_applications_index') }}" class="btn btn-sm rounded-pill {{ statut == '' ? 'btn-primary' : 'btn-outline-secondary text-white' }}">Toutes</a>
    <a href="{{ path('admin_applications_index', {statut: 'pending'}) }}" class="btn btn-sm rounded-pill {{ statut == 'pending' ? 'btn-warning text-dark' : 'btn-outline-secondary text-white' }}">En attente</a>
    <a href="{{ path('admin_applications_index', {statut: 'accepted'}) }}" class="btn btn-sm rounded-pill {{ statut == 'accepted' ? 'btn-success' : 'btn-outline-secondary text-white' }}">Acceptées</a>
    <a href="{{ path('admin_applications_index', {statut: 'refused'}) }}" class="btn btn-sm rounded-pill {{ statut == 'refused' ? 'btn-danger' : 'btn-outline-secondary text-white' }}">Refusées</a>
    <div class="ms-auto">
        <input type="text" id="searchInput" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="🔍 Rechercher (locataire, bien)..." style="width: 260px;">
    </div>
</div>

{# Table #}
<div class="table-responsive">
    <table class="table table-dark table-hover align-middle" id="applicationsTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Locataire</th>
                <th>Bien</th>
                <th>Date candidature</th>
                <th>Message</th>
                <th>Statut</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for app in applications %}
            <tr class="app-row" data-search="{{ app.locataire.fullName|lower }} {{ app.property.title|lower }}">
                <td class="text-muted small">{{ app.id }}</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold" style="width: 36px; height: 36px; flex-shrink: 0; font-size: 0.75rem;">
                            {{ app.locataire.fullName|slice(0,2)|upper }}
                        </div>
                        <div>
                            <div class="fw-bold small" style="color: var(--c-text);">{{ app.locataire.fullName }}</div>
                            <div class="text-muted" style="font-size: 0.72rem;">{{ app.locataire.email }}</div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="fw-bold small" style="color: var(--c-text);">{{ app.property.title }}</div>
                    <div class="text-muted" style="font-size: 0.72rem;"><i class="fa-solid fa-location-dot me-1"></i>{{ app.property.city }}</div>
                    <div class="text-primary" style="font-size: 0.72rem;">{{ app.property.pricePerMonth|number_format(0, ',', ' ') }} FCFA/mois</div>
                </td>
                <td class="small text-muted">{{ app.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                    {% if app.message %}
                        <span class="text-muted small" title="{{ app.message }}">{{ app.message|slice(0, 40) }}{% if app.message|length > 40 %}…{% endif %}</span>
                    {% else %}
                        <span class="text-muted small fst-italic">Aucun message</span>
                    {% endif %}
                </td>
                <td>
                    {% if app.statut == 'pending' %}
                        <span class="badge bg-warning text-dark rounded-pill px-3">En attente</span>
                    {% elseif app.statut == 'accepted' %}
                        <span class="badge bg-success rounded-pill px-3">Acceptée</span>
                    {% elseif app.statut == 'refused' %}
                        <span class="badge bg-danger rounded-pill px-3">Refusée</span>
                    {% else %}
                        <span class="badge bg-secondary rounded-pill px-3">{{ app.statut }}</span>
                    {% endif %}
                </td>
                <td class="text-end">
                    <a href="{{ path('admin_applications_show', {id: app.id}) }}" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        <i class="fa-solid fa-eye me-1"></i> Voir
                    </a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-5">
                    <i class="fa-solid fa-folder-open fs-2 opacity-25 d-block mb-2"></i>
                    Aucune candidature trouvée.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
document.getElementById('searchInput').addEventListener('input', function () {
    const q = this.value.toLowerCase();
    document.querySelectorAll('.app-row').forEach(row => {
        row.style.display = row.dataset.search.includes(q) ? '' : 'none';
    });
});
</script>
{% endblock %}
