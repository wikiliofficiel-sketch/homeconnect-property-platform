<header class="owner-header d-flex justify-content-between align-items-center py-3 px-4 shadow-lg sticky-top" style="background: var(--c-void); color: var(--c-body); border-bottom: 1px solid var(--c-border);">
    <div class="logo-area d-flex align-items-center">
        <div class="sidebar-toggle me-3 d-lg-none" style="color: var(--c-body);">
            <i class="fa-solid fa-bars fs-4 cursor-pointer"></i>
        </div>
        <div class="header-search d-none d-md-flex align-items-center rounded-pill px-3 py-1" style="background: var(--c-surface);">
            <i class="fa-solid fa-magnifying-glass small text-muted me-2"></i>
            <input type="text" class="bg-transparent border-0 small" placeholder="{{ 'dashboard.header.search'|trans }}" style="outline: none; color: var(--c-body);">
        </div>
    </div>
    
    <div class="d-flex align-items-center gap-3 gap-lg-4">
        <!-- Language Switcher -->
        <div class="dropdown">
            <button class="btn btn-link text-decoration-none dropdown-toggle p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--c-body);">
                <i class="fa-solid fa-globe fs-5"></i>
                <span class="small fw-bold text-uppercase">{{ app.request.locale|default('fr') }}</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 border-0 mt-3" style="background: var(--c-surface);">
                <li><a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2" 
                       href="{{ path('app_change_locale', {'locale': 'fr'}) }}" style="color: var(--c-body);">
                    <span class="fs-6">🇧🇯</span> Français
                </a></li>
                <li><a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2" 
                       href="{{ path('app_change_locale', {'locale': 'en'}) }}" style="color: var(--c-body);">
                    <span class="fs-6">🇺🇸</span> English
                </a></li>
                <li><a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2" 
                       href="{{ path('app_change_locale', {'locale': 'fon'}) }}" style="color: var(--c-body);">
                    <span class="fs-6">🇧🇯</span> Fon
                </a></li>
            </ul>
        </div>

        <!-- Theme Toggle Wrapper -->
        <div class="theme-switch-wrapper d-flex align-items-center px-3 py-1" style="background: var(--c-surface); border-radius: 12px; cursor: pointer; gap: 10px;" 
             id="theme-toggle" onclick="toggleTheme()">
            <i class="fas fa-moon fs-6" id="theme-icon" style="color: #f1c40f;"></i>
            <span class="small fw-bold d-none d-lg-inline" style="color: var(--c-body);">{{ 'dashboard.theme'|trans }}</span>
        </div>

        <!-- Notifications Dropdown -->
        <div class="dropdown">
            {# Count unread once via the pre-loaded collection to avoid multiple lazy loads #}
            {% set unreadNotifCount = app.user.notifications|filter(n => not n.lue)|length %}
            <div class="position-relative hover-scale cursor-pointer" style="color: var(--c-body);" data-bs-toggle="dropdown">
                <i class="fa-solid fa-bell fs-5"></i>
                {% if unreadNotifCount > 0 %}
                    <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle" style="font-size: 0.6rem;">{{ unreadNotifCount }}</span>
                {% endif %}
            </div>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 border-0 mt-3 p-0 overflow-hidden" style="width: 300px; background: var(--c-surface);">
                <li class="p-3 border-bottom border-white-10 d-flex justify-content-between align-items-center" style="background: var(--c-void);">
                    <h6 class="mb-0 fw-bold" style="color: var(--c-body);">{{ 'dashboard.notifications'|trans }}</h6>
                </li>
                <div style="max-height: 300px; overflow-y: auto;">
                    {% set recentNotifs = app.user.notifications|slice(0, 5) %}
                    {% for notif in recentNotifs %}
                    <li class="p-3 border-bottom border-white-10 hover-white-10">
                        <div class="d-flex gap-3">
                            <div class="bg-primary-subtle p-2 rounded-circle text-primary" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-info-circle"></i>
                            </div>
                            <div>
                                <p class="mb-0 small fw-bold" style="color: var(--c-body);">{{ notif.message|slice(0, 30) }}...</p>
                                <p class="mb-0 tiny" style="color: var(--c-text-muted);">{{ notif.createdAt|date('d/m/Y') }}</p>
                            </div>
                        </div>
                    </li>
                    {% else %}
                    <li class="p-4 text-center small" style="color: var(--c-text-muted);">{{ 'dashboard.header.no_notifications'|trans }}</li>
                    {% endfor %}
                </div>
                <li><a class="dropdown-item text-center py-2 small text-primary fw-bold" href="{{ path('app_owner_notifications') }}">{{ 'dashboard.actions.view_all'|trans }}</a></li>
            </ul>
        </div>

        <!-- User Profile Dropdown -->
        <div class="dropdown">
            <div class="d-flex align-items-center gap-3 cursor-pointer" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="text-end d-none d-sm-block">
                    <div class="fw-bold small" style="color: var(--c-body);">{{ app.user.fullName }}</div>
                    <div style="font-size: 0.7rem; color: var(--c-text-muted);">{{ 'dashboard.header.certified_owner'|trans }}</div>
                </div>
                <div class="position-relative">
                    <div class="rounded-circle border border-2 border-primary shadow-sm d-flex align-items-center justify-content-center bg-dark text-primary" style="width: 40px; height: 40px;">
                        <i class="fa-solid fa-user small"></i>
                    </div>
                    <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle"></span>
                </div>
            </div>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 border-0 mt-3 p-2" aria-labelledby="userDropdown" style="background: var(--c-surface); width: 220px;">
                <li class="px-3 py-2 border-bottom border-white-10 mb-2">
                    <div class="fw-bold small" style="color: var(--c-body);">{{ app.user.fullName }}</div>
                    <div style="font-size: 0.7rem; color: var(--c-text-muted);">{{ app.user.email }}</div>
                </li>
                <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_owner_profile')|default('#') }}" style="color: var(--c-text-muted);">
                    <i class="fa-solid fa-user-gear me-2"></i> {{ 'dashboard.header.my_profile'|trans }}
                </a></li>
                <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_owner_subscription') }}" style="color: var(--c-text-muted);">
                    <i class="fa-solid fa-crown me-2"></i> {{ 'dashboard.header.my_subscription'|trans }}
                </a></li>
                <li><hr class="dropdown-divider border-white-10"></li>
                <li><a class="dropdown-item rounded-3 py-2 text-danger" href="{{ path('app_logout') }}" onclick="logoutConfirm(event)">
                    <i class="fa-solid fa-right-from-bracket me-2"></i> {{ 'dashboard.logout'|trans }}
                </a></li>
            </ul>
        </div>
    </div>
</header>

<style>
.cursor-pointer { cursor: pointer; }
.hover-scale { transition: transform 0.2s; }
.hover-scale:hover { transform: scale(1.1); }
.owner-header { backdrop-filter: blur(10px); }
</style>
