{% extends 'owner/base.html.twig' %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" style="color: var(--c-text);">Contrats</li>
{% endblock %}

{% block content %}
<div class="contracts-container">
    <div class="page-header mb-5">
        <h1 class="display-6 fw-bold"><i class="fa-solid fa-file-signature text-primary"></i> Gestion des Contrats</h1>
        <p class="text-muted">Suivez vos baux et gérez les états des lieux de vos locataires.</p>
    </div>

    <div class="row g-4">
        {% for rental in rentals %}
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-5 overflow-hidden">
                    <div class="card-body p-4 d-flex align-items-center gap-4 flex-wrap">
                        <div class="property-preview" style="width: 100px; height: 75px;">
                            {% if rental.property.images and rental.property.images|length > 0 %}
                                <img src="{{ rental.property.images[0] starts with 'http' ? rental.property.images[0] : asset('uploads/properties/' ~ rental.property.images[0]) }}" class="w-100 h-100 rounded-4" style="object-fit: cover;">
                            {% else %}
                                <div class="w-100 h-100 rounded-4 bg-light d-flex align-items-center justify-content-center">
                                    <i class="fa-solid fa-house text-secondary opacity-25"></i>
                                </div>
                            {% endif %}
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">{{ rental.property.title }}</h5>
                            <p class="text-muted small mb-0">
                                <i class="fa-solid fa-user text-primary me-1"></i> Locataire : {{ rental.locataire.fullName }}<br>
                                <i class="fa-solid fa-calendar me-1"></i> Du {{ rental.startDate|date('d/m/Y') }} au {{ rental.endDate|date('d/m/Y') }}
                            </p>
                        </div>
                        <div class="status-badge">
                            <span class="badge bg-{{ rental.status == 'active' ? 'success' : 'warning' }} rounded-pill px-3">
                                {{ rental.status|capitalize }}
                            </span>
                        </div>
                        <div class="actions d-flex gap-2">
                            {% if not rental.isPaid %}
                                <form action="{{ path('app_owner_rental_remind', {id: rental.id}) }}" method="POST" onsubmit="return confirm('Envoyer une notification de relance à {{ rental.locataire.fullName }} ?')">
                                    <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">
                                        <i class="fa-solid fa-bell me-1"></i> Relancer
                                    </button>
                                </form>
                            {% else %}
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                    <i class="fa-solid fa-circle-check me-1"></i> Loyer à jour
                                </span>
                            {% endif %}
                            <a href="{{ path('app_owner_contract_generate', {id: rental.id}) }}" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" target="_blank">Contrat PDF</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center p-5 bg-white rounded-5 shadow-sm">
                <i class="fa-solid fa-file-circle-exclamation display-1 text-muted opacity-25 mb-4"></i>
                <h4>Aucun contrat actif</h4>
                <p class="text-muted">Vous n'avez pas encore de contrats de bail enregistrés.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
