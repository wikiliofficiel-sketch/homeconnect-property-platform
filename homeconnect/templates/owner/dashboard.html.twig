{% extends 'owner/base.html.twig' %}

{% block title %}Tableau de Bord - Espace Propriétaire{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" style="color: var(--c-text);">Tableau de bord</li>
{% endblock %}

{% block content %}

{# ── Bannière KYC selon statut ───────────────────────────────────────────── #}
{% set kycStatus = app.user.verificationStatus %}
{% if kycStatus == 'en_attente' %}
  <div class="alert alert-warning d-flex align-items-start gap-3 rounded-4 mb-4 p-4">
    <i class="fa-solid fa-clock fs-4 text-warning mt-1"></i>
    <div>
      <strong>Vérification en cours</strong><br>
      Vos documents KYC sont en cours d'examen par l'administrateur (24–48h).<br>
      <span class="dash-text-muted small">Les fonctionnalités seront débloquées après certification.</span>
    </div>
  </div>
  <div style="pointer-events:none;opacity:.45;filter:grayscale(.6);">

{% elseif kycStatus == 'rejete' %}
  <div class="alert alert-danger d-flex align-items-start gap-3 rounded-4 mb-4 p-4">
    <i class="fa-solid fa-circle-xmark fs-4 text-danger mt-1"></i>
    <div>
      <strong>Dossier KYC rejeté</strong><br>
      {{ app.user.kycRejectionReason|default('Motif non précisé.') }}<br>
      <a href="{{ path('app_owner_kyc') }}" class="btn btn-sm btn-outline-danger mt-2">
        <i class="fa-solid fa-upload me-1"></i>Renvoyer mes documents
      </a>
    </div>
  </div>
  <div style="pointer-events:none;opacity:.45;filter:grayscale(.6);">

{% elseif kycStatus == 'certifie' %}
  {# Compte certifié → accès normal #}
{% elseif kycStatus is null %}
  <div class="alert alert-warning d-flex align-items-start gap-3 rounded-4 mb-4 p-4">
    <i class="fa-solid fa-shield-exclamation fs-4 text-warning mt-1"></i>
    <div>
      <strong>Certification KYC requise</strong><br>
      Vous devez soumettre vos documents pour pouvoir publier des biens.<br>
      <a href="{{ path('app_owner_kyc') }}" class="btn btn-sm btn-warning mt-2">
        <i class="fa-solid fa-arrow-right me-1"></i>Démarrer la certification
      </a>
    </div>
  </div>
  <div style="pointer-events:none;opacity:.45;filter:grayscale(.6);">
{% endif %}

<div class="stats-grid">
    <div class="stat-premium-card">
        <div class="stat-premium-icon"><i class="fa-solid fa-house"></i></div>
        <div>
            <div class="stat-premium-value">{{ properties|length }}</div>
            <div class="stat-premium-label">Total Biens</div>
        </div>
    </div>
    <div class="stat-premium-card">
        <div class="stat-premium-icon" style="color:var(--c-gold); background:rgba(255,215,0,0.12);"><i class="fa-solid fa-circle-check"></i></div>
        <div>
            <div class="stat-premium-value">{{ stats.activeProperties|default(0) }}</div>
            <div class="stat-premium-label">Actifs</div>
        </div>
    </div>
    <div class="stat-premium-card">
        <div class="stat-premium-icon" style="color:var(--c-secondary); background:rgba(0,210,255,0.12);"><i class="fa-solid fa-file-invoice-dollar"></i></div>
        <div>
            <div class="stat-premium-value">{{ stats.totalRentals|default(0) }}</div>
            <div class="stat-premium-label">Locations</div>
        </div>
    </div>
    <div class="stat-premium-card">
        <div class="stat-premium-icon" style="color:#FF4B5C; background:rgba(255,75,92,0.12);"><i class="fa-solid fa-envelope-open-text"></i></div>
        <div>
            <div class="stat-premium-value">{{ pendingApplicationsCount|default(0) }}</div>
            <div class="stat-premium-label">Demandes</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Mes Biens -->
    <div class="col-lg-8">
        <div class="premium-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0" style="font-family: var(--f-serif);">Mes propriétés</h4>
                <a href="{{ path('app_owner_property_new') }}" class="btn-premium btn-sm text-decoration-none">
                    <i class="fa-solid fa-plus me-2"></i> Ajouter
                </a>
            </div>
            <div class="table-responsive">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Bien</th>
                            <th>Statut</th>
                            <th>Loyer</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for property in properties|slice(0, 5) %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    {% if property.images|first %}
                                        {% set imgSrc = property.images|first %}
                                        {% if imgSrc starts with 'http' or imgSrc starts with 'data:image' %}
                                            <img src="{{ imgSrc }}" class="rounded-3" width="60" height="50" style="object-fit:cover; border:1px solid var(--c-border);">
                                        {% else %}
                                            <img src="{{ asset('uploads/properties/' ~ imgSrc) }}" class="rounded-3" width="60" height="50" style="object-fit:cover; border:1px solid var(--c-border);">
                                        {% endif %}
                                    {% else %}
                                        <div class="rounded-3 dash-icon-bg d-flex align-items-center justify-content-center" style="width:60px; height:50px; border:1px solid var(--c-border);">
                                            <i class="fa-solid fa-house dash-text-muted" style="font-size:0.8rem;"></i>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <div class="fw-bold dash-text">{{ property.title }}</div>
                                        <div class="dash-text-muted small">{{ property.city }}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge-premium {{ property.statut == 'active' ? 'badge-active' : 'badge-pending' }}">
                                    {{ property.statut }}
                                </span>
                            </td>
                            <td class="fw-bold dash-text">{{ property.pricePerMonth|number_format(0, ',', ' ') }} <small>CFA</small></td>
                            <td>
                                <a href="{{ path('app_property_show', {'id': property.id}) }}" class="text-primary text-decoration-none fw-bold small">
                                    Gérer <i class="fa-solid fa-chevron-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Locations Récentes -->
        <div class="premium-card mt-4">
            <h4 class="fw-bold mb-4" style="font-family: var(--f-serif);">Locations & Contrats</h4>
            <div class="table-responsive">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Locataire</th>
                            <th>Paiement</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rental in rentals|slice(0, 3) %}
                        <tr>
                            <td>
                                <div class="fw-bold dash-text">{{ rental.locataire.fullName }}</div>
                                <div class="dash-text-muted small">{{ rental.property.title }}</div>
                            </td>
                            <td>
                                {% if rental.isPaid %}
                                    <span class="text-success small fw-bold"><i class="fa-solid fa-circle-check me-1"></i> À jour</span>
                                {% else %}
                                    <span class="text-warning small fw-bold"><i class="fa-solid fa-clock me-1"></i> En attente</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_owner_contract_generate', {id: rental.id}) }}" class="dash-text-muted" target="_blank">
                                    <i class="fa-solid fa-file-pdf fs-5"></i>
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="3" class="text-center py-4 dash-text-muted">Aucune location active.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Messages récents -->
    <div class="col-lg-4">
        <div class="premium-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0" style="font-family:var(--f-serif);">
                    <i class="fa-brands fa-whatsapp text-success me-2"></i> Messages
                </h4>
                <span class="badge bg-success rounded-pill px-2 py-1 small">Live</span>
            </div>

            <div class="chat-list mt-3">
                {% set adminMessages = recentMessages|filter(m => 'ROLE_ADMIN' in m.sender.roles) %}
                {% for message in adminMessages|slice(0, 6) %}
                <a href="{{ path('app_owner_messages_chat', {receiverId: message.sender.id}) }}"
                   class="d-flex align-items-center gap-3 p-3 rounded-4 mb-2 text-decoration-none dash-chat-item">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-success text-white shadow-sm"
                         style="width:45px; height:45px; min-width:45px;">
                        <i class="fa-solid fa-user-shield small"></i>
                    </div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold dash-text small">{{ message.sender.fullName }}</span>
                            <span class="dash-text-muted" style="font-size:0.6rem;">{{ message.createdAt|date('H:i') }}</span>
                        </div>
                        <div class="dash-text-muted small text-truncate">{{ message.content }}</div>
                    </div>
                </a>
                {% else %}
                <div class="text-center py-5 dash-text-muted" style="opacity:.4;">
                    <i class="fa-solid fa-comments fs-1 mb-2 d-block"></i>
                    <p class="small">Pas de messages admin</p>
                </div>
                {% endfor %}
            </div>

            <a href="{{ path('app_owner_messages') }}" class="btn-premium w-100 text-center mt-4 text-decoration-none">Tous les messages</a>
        </div>
    </div>
</div>

<style>
.dash-chat-item:hover { background: var(--c-primary-soft); }
</style>

{% if app.user.verificationStatus == 'en_attente' or app.user.verificationStatus == 'rejete' or app.user.verificationStatus is null %}
  </div>
{% endif %}

{% endblock %}
