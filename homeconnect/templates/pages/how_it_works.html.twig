{% extends 'base.html.twig' %}

{% block title %}{{ 'public.how_it_works.title'|trans }} — HomeConnect Bénin{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    --white:#0D0D1A;--accent:#ff7675;--success:#00d2d3;
    --c-surface: #1C1C2E; --c-white: #ffffff; --c-border: rgba(255,255,255,0.07); --c-indigo-pale: rgba(108, 92, 231, 0.1);
  }
  [data-theme="light"] {
    --black:#1a1a1a;
    --gray-dark:#2d3436;
    --gray-mid:#636e72;
    --gray-light:#b2bec3;
    --gray-bg:#ffffff;
    --gray-line:rgba(0,0,0,0.1);
    --white:#f8f9fa;
    --c-surface: #ffffff; --c-white: #1a1a1a; --c-border: rgba(0,0,0,0.07); --c-indigo-pale: rgba(108, 92, 231, 0.05);
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'Poppins',sans-serif;background:var(--white);color:var(--black);min-height:100vh;}
  .page-hero{margin-top:72px;background:linear-gradient(135deg,var(--wine-dark) 0%,var(--wine) 60%,var(--wine-light) 100%);padding:60px 5% 80px;position:relative;overflow:hidden;}
  .page-hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");}
  .hero-content{position:relative;z-index:1;}
  .hero-breadcrumb{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
  .hero-breadcrumb a{color:rgba(255,255,255,.7);font-size:13px;text-decoration:none;}
  .hero-breadcrumb a:hover{color:#fff;}
  .hero-breadcrumb i{color:rgba(255,255,255,.4);font-size:10px;}
  .hero-breadcrumb span{color:rgba(255,255,255,.95);font-size:13px;font-weight:500;}
  .hero-title{font-size:clamp(32px,5vw,48px);font-weight:800;color:#fff;letter-spacing:-.5px;}
  .hero-subtitle{margin-top:8px;color:rgba(255,255,255,.8);font-size:16px;max-width:600px;}

  .content-section{padding:60px 5% 80px;}
  .section-header{margin-bottom:50px;text-align:center;}
  .section-header h2{font-size:clamp(28px,4vw,40px);font-weight:800;color:var(--black);letter-spacing:-.5px;margin-bottom:12px;}
  .section-header p{font-size:16px;color:var(--gray-mid);max-width:600px;margin:0 auto;}

  .steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:30px;margin-bottom:60px;}
  .step-card{background:var(--white);border:1.5px solid var(--gray-line);border-radius:16px;padding:32px 24px;text-align:center;transition:all .3s;}
  .step-card:hover{border-color:var(--wine-light);box-shadow:0 8px 32px rgba(123,29,46,.12);transform:translateY(-4px);}
  .step-number{width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--wine-dark),var(--wine-light));color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;margin:0 auto 16px;}
  .step-card h3{font-size:18px;font-weight:700;color:var(--black);margin-bottom:8px;}
  .step-card p{font-size:14px;color:var(--gray-mid);line-height:1.7;}

  .features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px;}
  .feature-box{padding:28px 24px;background:var(--gray-bg);border-radius:14px;border:1px solid var(--gray-line);}
  .feature-box .icon{width:48px;height:48px;border-radius:12px;background:var(--wine-pale);display:flex;align-items:center;justify-content:center;color:var(--wine);font-size:22px;margin-bottom:14px;}
  .feature-box h4{font-size:16px;font-weight:700;color:var(--black);margin-bottom:8px;}
  .feature-box p{font-size:13px;color:var(--gray-mid);line-height:1.6;}

  .cta-section{background:linear-gradient(135deg,var(--wine-dark),var(--wine-light));padding:60px 5%;border-radius:16px;text-align:center;color:#fff;margin-bottom:80px;}
  .cta-section h2{font-size:clamp(24px,3vw,32px);font-weight:800;margin-bottom:12px;color:#fff;}
  .cta-section p{font-size:15px;color:rgba(255,255,255,.85);margin-bottom:28px;max-width:500px;margin-left:auto;margin-right:auto;}
  .btn-cta{display:inline-flex;align-items:center;gap:8px;padding:14px 32px;background:#fff;color:var(--wine);border:none;border-radius:10px;font-weight:700;font-size:15px;cursor:pointer;transition:all .2s;text-decoration:none;}
  .btn-cta:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.2);}

  footer{background:var(--black);padding:60px 5% 28px;color:rgba(255,255,255,.6);}
  .footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:40px;}
  .footer-brand .logo-name{color:#fff;}
  .footer-brand p{margin-top:14px;font-size:13px;line-height:1.7;color:rgba(255,255,255,.55);max-width:260px;}
  .footer-socials{display:flex;gap:10px;margin-top:20px;}
  .footer-socials a{width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.6);font-size:14px;text-decoration:none;transition:background .2s,color .2s;}
  .footer-socials a:hover{background:var(--wine);color:#fff;}
  .footer-col h4{font-size:13px;font-weight:700;color:#fff;margin-bottom:16px;letter-spacing:.3px;text-transform:uppercase;}
  .footer-col ul{list-style:none;display:flex;flex-direction:column;gap:9px;}
  .footer-col ul li a{font-size:13px;color:rgba(255,255,255,.5);text-decoration:none;transition:color .2s;}
  .footer-col ul li a:hover{color:var(--wine-light);}
  .footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
  .footer-bottom p{font-size:12px;}
  .footer-bottom-links{display:flex;gap:20px;}
  .footer-bottom-links a{font-size:12px;color:rgba(255,255,255,.4);text-decoration:none;}
  .footer-bottom-links a:hover{color:var(--wine-light);}
  @media(max-width:600px){.nav-links{display:none;}.nav-burger{display:flex;}.footer-grid{grid-template-columns:1fr 1fr;}}
</style>
{% endblock %}

{% block body %}

{% include 'partials/_navbar.html.twig' %}

<section class="page-hero">
  <div class="hero-content">
    <div class="hero-breadcrumb">
      <a href="{{ path('app_home') }}"><i class="fa-solid fa-house"></i> {{ 'public.nav.home'|trans|default('Accueil') }}</a>
      <i class="fa-solid fa-chevron-right"></i>
      <span>{{ 'public.how_it_works.title'|trans }}</span>
    </div>
    <h1 class="hero-title">{{ 'public.how_it_works.title'|trans }} 🚀</h1>
    <p class="hero-subtitle">{{ 'public.how_it_works.subtitle'|trans }}</p>
  </div>
</section>

<section class="content-section">
  <div class="section-header">
    <h2>{{ 'public.how_it_works.steps_title'|trans }}</h2>
    <p>{{ 'public.how_it_works.steps_sub'|trans }}</p>
  </div>

  <div class="steps-grid">
    <div class="step-card">
      <div class="step-number">1</div>
      <h3>{{ 'public.how_it_works.step1_title'|trans }}</h3>
      <p>{{ 'public.how_it_works.step1_desc'|trans }}</p>
    </div>
    <div class="step-card">
      <div class="step-number">2</div>
      <h3>{{ 'public.how_it_works.step2_title'|trans }}</h3>
      <p>{{ 'public.how_it_works.step2_desc'|trans }}</p>
    </div>
    <div class="step-card">
      <div class="step-number">3</div>
      <h3>{{ 'public.how_it_works.step3_title'|trans }}</h3>
      <p>{{ 'public.how_it_works.step3_desc'|trans }}</p>
    </div>
    <div class="step-card">
      <div class="step-number">4</div>
      <h3>{{ 'public.how_it_works.step4_title'|trans }}</h3>
      <p>{{ 'public.how_it_works.step4_desc'|trans }}</p>
    </div>
  </div>
</section>

<section class="content-section" style="background:var(--gray-bg);">
  <div class="section-header">
    <h2>{{ 'public.how_it_works.adv_title'|trans }}</h2>
    <p>{{ 'public.how_it_works.adv_sub'|trans }}</p>
  </div>

  <div class="features-grid">
    <div class="feature-box">
      <div class="icon"><i class="fa-solid fa-shield-halved"></i></div>
      <h4>{{ 'public.how_it_works.adv1_title'|trans }}</h4>
      <p>{{ 'public.how_it_works.adv1_desc'|trans }}</p>
    </div>
    <div class="feature-box">
      <div class="icon"><i class="fa-solid fa-file-contract"></i></div>
      <h4>{{ 'public.how_it_works.adv2_title'|trans }}</h4>
      <p>{{ 'public.how_it_works.adv2_desc'|trans }}</p>
    </div>
    <div class="feature-box">
      <div class="icon"><i class="fa-solid fa-mobile-screen-button"></i></div>
      <h4>{{ 'public.how_it_works.adv3_title'|trans }}</h4>
      <p>{{ 'public.how_it_works.adv3_desc'|trans }}</p>
    </div>
    <div class="feature-box">
      <div class="icon"><i class="fa-solid fa-star"></i></div>
      <h4>{{ 'public.how_it_works.adv4_title'|trans }}</h4>
      <p>{{ 'public.how_it_works.adv4_desc'|trans }}</p>
    </div>
    <div class="feature-box">
      <div class="icon"><i class="fa-solid fa-headset"></i></div>
      <h4>{{ 'public.how_it_works.adv5_title'|trans }}</h4>
      <p>{{ 'public.how_it_works.adv5_desc'|trans }}</p>
    </div>
    <div class="feature-box">
      <div class="icon"><i class="fa-solid fa-clock"></i></div>
      <h4>{{ 'public.how_it_works.adv6_title'|trans }}</h4>
      <p>{{ 'public.how_it_works.adv6_desc'|trans }}</p>
    </div>
  </div>
</section>

<section class="content-section">
  <div style="background:var(--wine-pale);border-radius:16px;padding:40px;border-left:4px solid var(--wine);">
    <h3 style="color:var(--wine);margin-bottom:12px;font-size:18px;"><i class="fa-solid fa-lightbulb" style="margin-right:8px;"></i> {{ 'public.how_it_works.expert_title'|trans }}</h3>
    <p style="color:var(--wine-dark);font-size:14px;line-height:1.7;">
      {{ 'public.how_it_works.expert_desc'|trans }}
    </p>
  </div>
</section>

<section class="cta-section">
  <h2>{{ 'public.how_it_works.ready_title'|trans }}</h2>
  <p>{{ 'public.how_it_works.ready_sub'|trans }}</p>
  <a href="{{ path('app_register') }}" class="btn-cta">
    <i class="fa-solid fa-rocket"></i> {{ 'public.how_it_works.ready_btn'|trans }}
  </a>
</section>

{% include 'partials/_footer.html.twig' %}


{% endblock %}
