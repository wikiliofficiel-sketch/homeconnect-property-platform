{% extends 'base.html.twig' %}

{% block title %}{{ property.title }} — HomeConnect{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="{{ path('app_property_index') }}" class="btn btn-outline-light rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-2"></i> Retour au catalogue
        </a>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 bg-transparent p-0">
                <li class="breadcrumb-item"><a href="{{ path('app_property_index') }}" class="text-primary text-decoration-none">Biens</a></li>
                <li class="breadcrumb-item active text-white-50" aria-current="page">Détails</li>
            </ol>
        </nav>
    </div>

    <div class="row g-5">
        <!-- Galerie Images -->
        <div class="col-lg-7">
            <div class="gallery-container rounded-4 overflow-hidden mb-4 shadow-lg" style="min-height: 450px;">
                {% if property.images|first %}
                    <img src="{{ property.images|first }}" class="w-100 main-image">
                {% else %}
                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-25" style="min-height: 450px;">
                        <i class="fa-solid fa-house-crack text-white-50" style="font-size: 5rem;"></i>
                    </div>
                {% endif %}
            </div>
            
            <div class="row g-2">
                {% for img in property.images|slice(1, 4) %}
                    <div class="col-3">
                        <img src="{{ img }}" class="w-100 rounded-3 shadow-sm thumbnail-img" style="height: 100px; object-fit: cover;">
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Détails & Action -->
        <div class="col-lg-5">
            <div class="card card-premium p-4 h-100">
                <div class="badge bg-primary-subtle text-primary mb-3 d-inline-block px-3 py-2 rounded-pill fw-bold">
                    {{ property.type|capitalize }}
                </div>
                <h1 class="h2 fw-bold mb-3">{{ property.title }}</h1>
                <p class="text-white-50 mb-4">
                    <i class="fa-solid fa-location-dot text-primary me-2"></i> {{ property.city }}, {{ property.address }}
                </p>

                <div class="d-flex gap-4 mb-4 border-bottom border-white-10 pb-4">
                    <div class="text-center">
                        <div class="fs-4 fw-bold">{{ property.rooms }}</div>
                        <div class="text-white-50 x-small text-uppercase">Pièces</div>
                    </div>
                    <div class="text-center">
                        <div class="fs-4 fw-bold">{{ property.bedrooms }}</div>
                        <div class="text-white-50 x-small text-uppercase">Chambres</div>
                    </div>
                    <div class="text-center">
                        <div class="fs-4 fw-bold">{{ property.surface }}</div>
                        <div class="text-white-50 x-small text-uppercase">m²</div>
                    </div>
                </div>

                <div class="mb-5">
                    <h5 class="fw-bold mb-3">Description</h5>
                    <p class="text-white-50" style="line-height: 1.8;">
                        {{ property.description }}
                    </p>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold mb-3">Caractéristiques & Équipements</h5>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="d-flex align-items-center bg-dark bg-opacity-25 p-2 rounded-3">
                                <i class="fa-solid fa-bed text-primary me-3 fs-5"></i>
                                <span>{{ property.bedrooms }} Chambres</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center bg-dark bg-opacity-25 p-2 rounded-3">
                                <i class="fa-solid fa-ruler-combined text-primary me-3 fs-5"></i>
                                <span>{{ property.surface }} m²</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center bg-dark bg-opacity-25 p-2 rounded-3">
                                <i class="fa-solid {% if property.hasParking %}fa-square-check text-success{% else %}fa-square-xmark text-danger{% endif %} me-3 fs-5"></i>
                                <span>Parking</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center bg-dark bg-opacity-25 p-2 rounded-3">
                                <i class="fa-solid {% if property.furnished %}fa-square-check text-success{% else %}fa-square-xmark text-danger{% endif %} me-3 fs-5"></i>
                                <span>Meublé</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-auto pt-4 border-top border-white-10">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <div class="text-white-50 small">Loyer mensuel</div>
                            <div class="fs-2 fw-bold text-primary">{{ property.pricePerMonth|number_format(0, ',', ' ') }} <small class="fs-6">CFA</small></div>
                        </div>
                        {% if property.deposit %}
                            <div class="text-end">
                                <div class="text-white-50 small">Caution</div>
                                <div class="fw-bold">{{ property.deposit|number_format(0, ',', ' ') }} CFA</div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="d-grid gap-2">
                        {% if app.user %}
                            {% if is_granted('ROLE_LOCATAIRE') %}
                                <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#applyModal">
                                    <i class="fa-solid fa-paper-plane me-2"></i> Postuler à ce bien
                                </button>
                            {% else %}
                                <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm" onclick="if(typeof Swal !== 'undefined') { Swal.fire({title: 'Accès refusé', text: 'Seuls les comptes Locataires peuvent déposer un dossier pour un bien.', icon: 'error', background: 'var(--c-surface)', color: 'white'}); } else { alert('Seuls les comptes Locataires peuvent déposer un dossier.'); }">
                                    <i class="fa-solid fa-paper-plane me-2"></i> Postuler à ce bien
                                </button>
                            {% endif %}
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm text-decoration-none text-center">
                                <i class="fa-solid fa-lock me-2"></i> Connectez-vous pour postuler
                            </a>
                        {% endif %}

                        <div class="d-flex gap-2">
                            <button onclick="shareProperty()" class="btn btn-outline-light border rounded-pill fw-bold py-2 flex-grow-1">
                                <i class="fa-solid fa-share-nodes me-2"></i> Partager
                            </button>
                            <button onclick="window.print()" class="btn btn-outline-light border rounded-pill fw-bold py-2 flex-grow-1">
                                <i class="fa-solid fa-file-pdf me-2"></i> PDF
                            </button>
                        </div>

                        {% if app.user %}
                            {% set chatPath = is_granted('ROLE_PROPRIETAIRE') ? path('app_owner_messages_chat', {receiverId: 13}) : path('app_tenant_messages_chat', {receiverId: 13}) %}
                            <a href="{{ chatPath }}" class="btn btn-outline-secondary rounded-pill fw-bold py-3 text-decoration-none text-center">
                                <i class="fa-solid fa-comments me-2"></i> Contacter l'Admin (Chat)
                            </a>
                        {% else %}
                            <a href="{{ path('app_contact') }}" class="btn btn-outline-secondary rounded-pill fw-bold py-3 text-decoration-none text-center">
                                <i class="fa-solid fa-envelope me-2"></i> Contacter l'Admin (Formulaire)
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block body_end %}
<!-- Modal de Candidature (Page Publique) -->
{% if app.user and is_granted('ROLE_LOCATAIRE') %}
<div class="modal fade" id="applyModal" tabindex="-1" aria-hidden="true" style="z-index: 2000;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg" style="background: var(--c-surface); color: white;">
            <div class="modal-header border-0 p-4 pb-0">
                <h4 class="modal-title fw-bold" style="font-family: var(--f-serif);">Candidature pour ce bien</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="POST" action="{{ path('app_tenant_apply', {id: property.id}) }}">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-white-50">Date d'entrée souhaitée</label>
                            <input type="date" class="form-control bg-dark border-secondary text-white rounded-pill px-3" name="dateDebut" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-white-50">Date de fin prévue</label>
                            <input type="date" class="form-control bg-dark border-secondary text-white rounded-pill px-3" name="dateFin" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-white-50">Message pour le propriétaire (facultatif)</label>
                        <textarea class="form-control bg-dark border-secondary text-white rounded-4 p-3" name="message" rows="3" placeholder="Présentez-vous brièvement..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow-sm">
                        <i class="fa-solid fa-check me-2"></i> Envoyer ma candidature
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endif %}

<style>
.main-image { height: 450px; object-fit: cover; }
.thumbnail-img { cursor: pointer; transition: opacity 0.2s; }
.thumbnail-img:hover { opacity: 0.8; }
.x-small { font-size: 0.7rem; }
@media print {
    .btn, .modal, .breadcrumb, .gallery-container + .row { display: none !important; }
    .card-premium { border: none !important; box-shadow: none !important; color: black !important; background: white !important; }
    .text-white-50, .text-primary { color: black !important; }
    body { background: white !important; }
}
</style>

<script>
function shareProperty() {
    if (navigator.share) {
        navigator.share({
            title: '{{ property.title }}',
            text: 'Découvrez ce bien sur HomeConnect',
            url: window.location.href
        }).catch(console.error);
    } else {
        navigator.clipboard.writeText(window.location.href);
        if(typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Lien copié !',
                text: 'Lien copié dans le presse-papier.',
                icon: 'success',
                timer: 2000,
                showConfirmButton: false,
                background: 'var(--c-surface)',
                color: 'white'
            });
        } else {
            alert('Lien copié !');
        }
    }
}
</script>
{% endblock %}
