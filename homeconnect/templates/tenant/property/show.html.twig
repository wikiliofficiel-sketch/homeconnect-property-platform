            <div class="mb-3">
                <label class="report-label">Niveau de priorité *</label>
                <div class="priority-grid">
                    <label class="priority-option prio-low">
                        <input type="radio" name="priority" value="low" required>
                        <i class="fa-solid fa-circle-dot"></i> Basse
                    </label>
                    <label class="priority-option prio-medium">
