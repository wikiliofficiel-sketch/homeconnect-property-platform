                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" style="background:#fff;">
                <form method="POST" action="{{ path('app_tenant_apply', {id: property.id}) }}">
                    <div class="mb-3">
                        <label class="d-block mb-1" style="font-size:11px; font-weight:700; color:#666; text-transform:uppercase; letter-spacing:.06em;">Date d'entrée souhaitée <span style="color:#e74c3c;">*</span></label>
                        <input type="date" class="form-control rounded-3" name="dateDebut" required min="{{ 'now'|date('Y-m-d') }}"
                               style="color:#333; background:#f8f9fa; border:1px solid #dee2e6; font-size:14px;">
                    </div>
                    <div class="mb-3 p-3 rounded-3 d-flex align-items-center gap-3" style="background:#f0faf4; border:1px solid #b2dfdb;">
                        <i class="fa-solid fa-file-circle-check fs-4" style="color:#27ae60;"></i>
                        <div class="small">
                            <strong style="color:#1a5c37; display:block;">Votre dossier sera joint automatiquement</strong>
                            <span style="color:#4a7c5e;">Complétez votre profil pour augmenter vos chances</span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="d-block mb-1" style="font-size:11px; font-weight:700; color:#666; text-transform:uppercase; letter-spacing:.06em;">Message (facultatif)</label>
                        <textarea class="form-control rounded-3" name="message" rows="3"
                                  placeholder="Présentez-vous et expliquez pourquoi ce bien vous intéresse…"
                                  style="color:#333; background:#f8f9fa; border:1px solid #dee2e6; font-size:14px; resize:none;"></textarea>
                    </div>
                    <button type="submit" class="btn btn-lg w-100 rounded-pill fw-bold py-3 shadow"
                        style="background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;font-size:15px;">
                        <i class="fa-solid fa-paper-plane me-2"></i> Envoyer ma candidature
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{# ══ Modal Signaler ══════════════════════════════════════════════════ #}
<div id="reportModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:10070;align-items:center;justify-content:center;padding:1rem;"
     onclick="if(event.target===this)this.style.display='none'">
    <div class="report-modal-box">
        <div class="report-modal-head">
            <i class="fa-solid fa-flag" style="color:#e74c3c;"></i>
            <h5 style="margin:0;">Signaler ce bien</h5>
            <button onclick="document.getElementById('reportModal').style.display='none'"
                style="background:none;border:none;color:#999;font-size:1.2rem;cursor:pointer;margin-left:auto;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form method="POST" action="{{ path('app_tenant_report_create') }}" class="report-modal-body">
            <input type="hidden" name="propertyId" value="{{ property.id }}">

            {# Motif #}
            <div class="mb-3">
                <label class="report-label">Motif *</label>
                <select name="reason" class="report-select" required>
                    <option value="">Choisir un motif…</option>
                    <option value="Fausse annonce / photos trompeuses">Fausse annonce / photos trompeuses</option>
                    <option value="Prix abusif ou anormal">Prix abusif ou anormal</option>
                    <option value="Arnaque / Escroquerie">Arnaque / Escroquerie</option>
                    <option value="Contenu inapproprié">Contenu inapproprié</option>
                    <option value="Bien déjà loué ou indisponible">Bien déjà loué ou indisponible</option>
                    <option value="Harcèlement du propriétaire">Harcèlement du propriétaire</option>
                    <option value="Autre">Autre</option>
                </select>
            </div>

