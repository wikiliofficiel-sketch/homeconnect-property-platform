            <button type="submit" class="report-submit-btn">
                <i class="fa-solid fa-paper-plane me-2"></i> Envoyer le signalement
            </button>
        </form>
    </div>
</div>

<style>
/* ══ Réactions ═══════════════════════════════════════════════════ */
.react-bar {
