{% extends 'tenant/base.html.twig' %}

{% block tenant_content %}
<div class="pd-wrap">

{# ══════════════════ GALERIE ══════════════════════════════════════════ #}
<div class="pd-gallery mb-4">
    <div class="row g-2" style="border-radius: 20px; overflow: hidden; max-height: 520px;">
        <div class="col-md-8">
            <div class="pd-main-img" id="mainImgWrapper">
                {% if property.images and property.images|length > 0 %}
                    {% set img0 = property.images[0] %}
                    <img id="mainGalleryImg"
                         src="{{ img0 starts with 'http' or img0 starts with 'data:' or img0 starts with '/' ? img0 : asset('uploads/properties/' ~ img0) }}"
                         alt="{{ property.title }}"
                         onclick="openLightbox(currentMainIdx)">
                {% else %}
                    <div class="pd-no-img"><i class="fa-solid fa-house"></i></div>
                {% endif %}
                {# Flèches navigation #}
                {% if property.images|length > 1 %}
                <button class="pd-nav-btn pd-nav-prev" onclick="navigateMain(-1)" title="Photo précédente">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="pd-nav-btn pd-nav-next" onclick="navigateMain(1)" title="Photo suivante">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
                {% endif %}
                <div class="pd-gallery-badges">
                    <span class="pd-badge-white" id="photoCounter"><i class="fa-solid fa-camera me-1"></i>1 / {{ property.images ? property.images|length : 0 }}</span>
                    {% if property.videoUrl %}<span class="pd-badge-white"><i class="fa-solid fa-video me-1"></i>Vidéo</span>{% endif %}
                </div>
                <form method="POST" action="{{ path('app_tenant_favorite_toggle', {propertyId: property.id}) }}" class="pd-fav-btn">
                    <button type="submit" title="{% if isFavorite %}Retirer des favoris{% else %}Ajouter aux favoris{% endif %}">
                        <i class="fa-{{ isFavorite ? 'solid' : 'regular' }} fa-heart" style="color: {{ isFavorite ? '#e74c3c' : '#666' }};"></i>
                    </button>
                </form>
            </div>
        </div>
        <div class="col-md-4 d-flex flex-column gap-2">
            {% for i in 1..2 %}
            <div class="pd-side-img {{ i == 2 and property.images|length > 3 ? 'has-more' : '' }}" onclick="setMainImage({{ i }})">
                {% if property.images and property.images[i] is defined %}
                    {% set imgN = property.images[i] %}
                    <img src="{{ imgN starts with 'http' or imgN starts with 'data:' or imgN starts with '/' ? imgN : asset('uploads/properties/' ~ imgN) }}" alt="Photo {{ i+1 }}">
                {% else %}
                    <div class="pd-no-img" style="min-height: 0; height: 100%;"><i class="fa-solid fa-image opacity-25"></i></div>
                {% endif %}
                {% if i == 2 and property.images|length > 3 %}
                <div class="pd-more-overlay" onclick="openLightbox(2)">+{{ property.images|length - 3 }} photos</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>

    {# Bande de miniatures #}
    {% if property.images|length > 1 %}
    <div class="pd-thumbs" id="galleryThumbs">
        {% for i, img in property.images %}
        <div class="pd-thumb {{ i == 0 ? 'pd-thumb-active' : '' }}" id="thumb-{{ i }}" onclick="setMainImage({{ i }})">
            <img src="{{ img starts with 'http' or img starts with 'data:' or img starts with '/' ? img : asset('uploads/properties/' ~ img) }}" alt="Miniature {{ i+1 }}">
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>

{# ══════════════════ CONTENU PRINCIPAL ════════════════════════════════ #}
<div class="row g-5">

{# ─────────── COLONNE GAUCHE ─────────── #}
<div class="col-lg-8">

    {# TITRE + PRIX #}
    <div class="pd-card mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    {% if property.type %}<span class="pd-type-chip">{{ property.type|capitalize }}</span>{% endif %}
                    {% if property.statutAnnonce %}<span class="pd-annonce-chip">{{ property.statutAnnonce }}</span>{% endif %}
                </div>
                <h1 class="pd-title">{{ property.title }}</h1>
                <p class="pd-location"><i class="fa-solid fa-location-dot me-2" style="color:#667eea;"></i>{{ property.getFullAddress() }}</p>
            </div>
            <div class="text-end">
                {% if property.statutAnnonce != 'À vendre' %}
                <div class="pd-price">{{ property.pricePerMonth|number_format(0, ',', ' ') }} <span class="pd-price-unit">FCFA/mois</span></div>
                {% endif %}
                {% if property.prixVente and property.statutAnnonce != 'À louer' %}
                <div style="font-size: 1.2rem; font-weight: 700; color: #2980b9; margin-top: 4px;">{{ property.prixVente|number_format(0, ',', ' ') }} FCFA <small style="font-size:12px; color:#666;">(vente)</small></div>
                {% endif %}
            </div>
        </div>

        {# Amenities rapides #}
        <div class="pd-amenities-row">
            {% if property.rooms %}<div class="pd-amenity"><i class="fa-solid fa-door-open"></i><span>{{ property.rooms }} pièces</span></div>{% endif %}
            {% if property.bedrooms %}<div class="pd-amenity"><i class="fa-solid fa-bed"></i><span>{{ property.bedrooms }} chambres</span></div>{% endif %}
            {% if property.nbSallesDeBain %}<div class="pd-amenity"><i class="fa-solid fa-bath"></i><span>{{ property.nbSallesDeBain }} SDB</span></div>{% endif %}
            {% if property.surface %}<div class="pd-amenity"><i class="fa-solid fa-ruler-combined"></i><span>{{ property.surface }} m²</span></div>{% endif %}
            {% if property.etage is not null %}<div class="pd-amenity"><i class="fa-solid fa-building"></i><span>{{ property.etage == 0 ? 'RDC' : 'Étage '~property.etage }}</span></div>{% endif %}
            {% if property.typeCuisine %}<div class="pd-amenity"><i class="fa-solid fa-kitchen-set"></i><span>{{ property.typeCuisine }}</span></div>{% endif %}
        </div>
    </div>

    {# DESCRIPTION #}
    <div class="pd-card mb-4">
        <div class="pd-section-title">Description</div>
        <p style="color: #555; line-height: 1.85; font-size: 15px; white-space: pre-line; margin: 0;">{{ property.description }}</p>
    </div>

    {# VIDÉO #}
    {% if property.videoUrl %}
    <div class="pd-card mb-4">
        <div class="pd-section-title"><i class="fa-solid fa-video text-primary me-2"></i>Vidéo de présentation</div>
        {% set videoId = '' %}
        {% if 'youtube.com/watch?v=' in property.videoUrl %}
            {% set videoId = property.videoUrl|split('v=')[1]|split('&')[0] %}
        {% elseif 'youtu.be/' in property.videoUrl %}
            {% set videoId = property.videoUrl|split('youtu.be/')[1]|split('?')[0] %}
        {% endif %}
        {% if videoId %}
        <div style="position:relative; padding-bottom:56.25%; height:0; border-radius:12px; overflow:hidden;">
            <iframe src="https://www.youtube.com/embed/{{ videoId }}" frameborder="0" allowfullscreen
                style="position:absolute; top:0; left:0; width:100%; height:100%;"></iframe>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {# ÉQUIPEMENTS #}
    {% if property.equipements and property.equipements|length > 0 %}
    <div class="pd-card mb-4">
        <div class="pd-section-title">Équipements inclus</div>
        {% set equipIcons = {
            'wifi': 'fa-wifi', 'climatisation': 'fa-snowflake', 'ventilateur': 'fa-fan',
            'chauffage': 'fa-fire', 'eau_courante': 'fa-droplet', 'groupe_electrogene': 'fa-bolt',
            'panneaux_solaires': 'fa-solar-panel', 'gardiennage': 'fa-user-shield',
            'interphone': 'fa-phone', 'alarme': 'fa-bell', 'piscine': 'fa-water-ladder',
            'salle_sport': 'fa-dumbbell', 'buanderie': 'fa-shirt', 'meuble': 'fa-couch'
        } %}
        <div class="pd-equip-grid">
            {% for eq in property.equipements %}
            <div class="pd-equip-item">
                <i class="fa-solid {{ equipIcons[eq] ?? 'fa-check-circle' }}" style="color:#667eea;"></i>
                <span>{{ eq|replace({'_': ' '})|capitalize }}</span>
            </div>
            {% endfor %}
            {% if property.hasParking %}<div class="pd-equip-item"><i class="fa-solid fa-square-parking" style="color:#667eea;"></i><span>Parking</span></div>{% endif %}
            {% if property.hasJardin %}<div class="pd-equip-item"><i class="fa-solid fa-tree" style="color:#667eea;"></i><span>Jardin</span></div>{% endif %}
            {% if property.hasBalcon %}<div class="pd-equip-item"><i class="fa-solid fa-door-open" style="color:#667eea;"></i><span>Balcon</span></div>{% endif %}
            {% if property.hasAscenseur %}<div class="pd-equip-item"><i class="fa-solid fa-elevator" style="color:#667eea;"></i><span>Ascenseur</span></div>{% endif %}
        </div>
    </div>
    {% endif %}

    {# INFOS COMPLÉMENTAIRES #}
    <div class="pd-card mb-4">
        <div class="pd-section-title">Informations complémentaires</div>
        <div class="pd-info-grid">
            {% if property.disponibilite %}
            <div class="pd-info-item"><i class="fa-solid fa-calendar-check" style="color:#27ae60;"></i><div><span class="pd-info-label">Disponible dès</span><strong>{{ property.disponibilite }}</strong></div></div>
            {% endif %}
            {% if property.dureeMinLocation %}
            <div class="pd-info-item"><i class="fa-solid fa-clock" style="color:#f39c12;"></i><div><span class="pd-info-label">Durée min. location</span><strong>{{ property.dureeMinLocation }} mois</strong></div></div>
            {% endif %}
            {% if property.preavis %}
            <div class="pd-info-item"><i class="fa-solid fa-bell" style="color:#e67e22;"></i><div><span class="pd-info-label">Préavis</span><strong>{{ property.preavis }} mois</strong></div></div>
            {% endif %}
            {% if property.deposit %}
            <div class="pd-info-item"><i class="fa-solid fa-lock" style="color:#3498db;"></i><div><span class="pd-info-label">Dépôt de garantie</span><strong>{{ property.deposit|number_format(0, ',', ' ') }} FCFA</strong></div></div>
            {% endif %}
            {% if property.chargesComprises %}
            <div class="pd-info-item"><i class="fa-solid fa-circle-check" style="color:#27ae60;"></i><div><span class="pd-info-label">Charges</span><strong>Comprises</strong></div></div>
            {% elseif property.montantCharges %}
            <div class="pd-info-item"><i class="fa-solid fa-receipt" style="color:#e74c3c;"></i><div><span class="pd-info-label">Charges</span><strong>{{ property.montantCharges|number_format(0, ',', ' ') }} FCFA/mois</strong></div></div>
            {% endif %}
            {% if property.fraisAgence %}
            <div class="pd-info-item"><i class="fa-solid fa-handshake" style="color:#9b59b6;"></i><div><span class="pd-info-label">Frais d'agence</span><strong>{{ property.fraisAgence|number_format(0, ',', ' ') }} FCFA</strong></div></div>
            {% endif %}
        </div>
    </div>

    {# RÈGLES #}
    {% if property.animauxAcceptes is not null or property.fumeursAcceptes is not null %}
    <div class="pd-card mb-4">
        <div class="pd-section-title">Règles du bien</div>
        <div class="d-flex gap-3 flex-wrap">
            <div class="pd-rule {{ property.animauxAcceptes ? 'rule-ok' : 'rule-no' }}">
                <i class="fa-solid fa-dog"></i>
                <span>Animaux {% if property.animauxAcceptes %}acceptés{% else %}non acceptés{% endif %}</span>
            </div>
            <div class="pd-rule {{ property.fumeursAcceptes ? 'rule-ok' : 'rule-no' }}">
                <i class="fa-solid fa-smoking{% if not property.fumeursAcceptes %}-ban{% endif %}"></i>
                <span>Fumeurs {% if property.fumeursAcceptes %}acceptés{% else %}non acceptés{% endif %}</span>
            </div>
        </div>
    </div>
    {% endif %}

    {# STATISTIQUES PUBLIQUES #}
    <div class="pd-card mb-4">
        <div class="pd-section-title">Statistiques du bien</div>
        <div class="d-flex gap-4 flex-wrap">
            <div class="pd-public-stat"><i class="fa-solid fa-eye" style="color:#667eea;"></i><div><strong>{{ property.views }}</strong><span>vues</span></div></div>
            <div class="pd-public-stat"><i class="fa-solid fa-calendar" style="color:#667eea;"></i><div><strong>{{ property.createdAt|date('d/m/Y') }}</strong><span>publié le</span></div></div>
            {% if property.views > 50 %}<div class="pd-public-stat"><i class="fa-solid fa-fire" style="color:#e74c3c;"></i><div><strong>Populaire</strong><span>bien demandé</span></div></div>{% endif %}
        </div>
    </div>

    {# AVIS SUR LE PROPRIÉTAIRE #}
    <div class="pd-card mb-4">
        <div class="pd-section-title">Avis sur le propriétaire</div>
        {% if reviews|length > 0 %}
        <div class="d-flex align-items-center gap-3 mb-4">
            <div style="font-size: 2.5rem; font-weight: 800; color: #f39c12;">{{ avgRating|number_format(1) }}</div>
            <div>
                <div class="pd-stars">
                    {% for i in 1..5 %}
                        <i class="fa-{{ i <= avgRating|round ? 'solid' : 'regular' }} fa-star" style="color: #f39c12;"></i>
                    {% endfor %}
                </div>
                <div style="font-size: 13px; color: #888;">{{ reviews|length }} évaluation{% if reviews|length > 1 %}s{% endif %}</div>
            </div>
        </div>
        {% for review in reviews|slice(0, 3) %}
        <div class="pd-review">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="pd-review-avatar">{{ review.author.prenom|slice(0,1)|upper }}</div>
                <div>
                    <strong style="color:#2c3e50;">{{ review.author.fullName }}</strong>
                    <div class="pd-stars" style="font-size: 12px;">
                        {% for i in 1..5 %}<i class="fa-{{ i <= review.rating ? 'solid' : 'regular' }} fa-star" style="color:#f39c12;"></i>{% endfor %}
                    </div>
                </div>
                <span style="margin-left:auto; font-size:12px; color:#aaa;">{{ review.createdAt is defined ? review.createdAt|date('d/m/Y') : '' }}</span>
            </div>
            <p style="color:#666; font-size: 14px; margin:0; font-style: italic;">"{{ review.comment }}"</p>
        </div>
        {% endfor %}
        {% else %}
        <p style="color:#aaa; font-style:italic; font-size:14px; margin:0;">Aucun avis pour ce propriétaire encore.</p>
        {% endif %}
    </div>

    {# ── RÉACTIONS SOCIALES ─────────────────────────────────────── #}
    <div class="pd-card mb-4">
        <div class="pd-card-title mb-3"><i class="fa-solid fa-heart-pulse me-2"></i>Réactions</div>
        <div class="react-bar">
            {# J'aime #}
            <form method="POST" action="{{ path('app_tenant_property_react', {id: property.id}) }}" style="display:inline;">
                <input type="hidden" name="type" value="like">
                <button type="submit" class="react-btn {{ userInteraction and userInteraction.type == 'like' ? 'react-active-like' : '' }}">
                    <i class="fa-{{ userInteraction and userInteraction.type == 'like' ? 'solid' : 'regular' }} fa-thumbs-up"></i>
                    <span>{{ likesCount }}</span>
                </button>
            </form>

            {# Je n'aime pas #}
            <form method="POST" action="{{ path('app_tenant_property_react', {id: property.id}) }}" style="display:inline;">
                <input type="hidden" name="type" value="dislike">
                <button type="submit" class="react-btn {{ userInteraction and userInteraction.type == 'dislike' ? 'react-active-dislike' : '' }}">
                    <i class="fa-{{ userInteraction and userInteraction.type == 'dislike' ? 'solid' : 'regular' }} fa-thumbs-down"></i>
                    <span>{{ dislikesCount }}</span>
                </button>
            </form>

            {# Commenter #}
            <button type="button" class="react-btn" onclick="document.getElementById('commentSection').scrollIntoView({behavior:'smooth'})">
                <i class="fa-regular fa-comment"></i>
                <span>{{ propertyComments|length }}</span>
            </button>

            {# Partager #}
            <button type="button" class="react-btn" onclick="shareProperty()">
                <i class="fa-solid fa-share-nodes"></i>
                <span>Partager</span>
            </button>

            {# Signaler #}
            <button type="button" class="react-btn react-report" onclick="document.getElementById('reportModal').style.display='flex'">
                <i class="fa-solid fa-flag"></i>
                <span>Signaler</span>
            </button>
        </div>
    </div>

    {# ── COMMENTAIRES ────────────────────────────────────────────── #}
    <div class="pd-card mb-4" id="commentSection">
        <div class="pd-card-title mb-3">
            <i class="fa-regular fa-comments me-2"></i>Commentaires
            <span class="comment-count-badge">{{ propertyComments|length }}</span>
        </div>

        {# Formulaire nouveau commentaire #}
        <form method="POST" action="{{ path('app_tenant_property_comment', {id: property.id}) }}" class="mb-4">
            <div class="comment-form-wrap">
                <div class="comment-self-av">{{ app.user.prenom|slice(0,1)|upper }}</div>
                <div class="comment-input-area">
                    <textarea name="content" id="commentInput" maxlength="500" rows="2"
                        placeholder="Partagez votre avis sur ce bien…"
                        oninput="updateCharCount(this)"></textarea>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <small id="charCount" style="color:#aaa; font-size:11px;">0 / 500</small>
                        <button type="submit" class="comment-submit-btn">
                            <i class="fa-solid fa-paper-plane me-1"></i> Publier
                        </button>
                    </div>
                </div>
            </div>
        </form>

        {# Liste des commentaires #}
        {% if propertyComments|length > 0 %}
            {% for comment in propertyComments %}
            <div class="comment-item">
                <div class="comment-av">{{ comment.author.prenom|slice(0,1)|upper }}</div>
                <div class="comment-body">
                    <div class="comment-header">
                        <strong>{{ comment.author.fullName }}</strong>
                        <span class="comment-date">{{ comment.createdAt|date('d/m/Y à H:i') }}</span>
                        {% if comment.author.id == app.user.id %}
                        <form method="POST" action="{{ path('app_tenant_property_comment_delete', {id: comment.id}) }}" style="margin-left:auto;"
                              onsubmit="return confirm('Supprimer ce commentaire ?')">
                            <button type="submit" class="comment-delete-btn" title="Supprimer">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </form>
                        {% endif %}
                    </div>
                    <p class="comment-text">{{ comment.content }}</p>
                </div>
            </div>
            {% endfor %}
        {% else %}
        <div class="comment-empty">
            <i class="fa-regular fa-comment-dots"></i>
            <p>Aucun commentaire pour l'instant. Soyez le premier !</p>
        </div>
        {% endif %}
    </div>

    {# ── SIGNALER (compact) ──────────────────────────────────────── #}
    <div class="pd-card mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <p style="color:#999; font-size:13px; margin:0;">Ce bien vous semble incorrect ou abusif ?</p>
            <button onclick="document.getElementById('reportModal').style.display='flex'" class="pd-report-btn">
                <i class="fa-solid fa-flag me-2"></i> Signaler
            </button>
        </div>
    </div>

</div>

{# ─────────── COLONNE DROITE (STICKY) ─────────── #}
<div class="col-lg-4">
    <div class="pd-sidebar">

        {# Postuler #}
        <div class="pd-sidebar-card mb-3">
            <div style="text-align:center; padding: 1.5rem 1.5rem 0;">
                <div class="pd-sidebar-price">{{ property.pricePerMonth|number_format(0, ',', ' ') }}<span>/mois</span></div>
                <p style="color:#aaa; font-size:12px; margin: 4px 0 0;">FCFA · Hors charges de caution</p>
            </div>
            <div style="padding: 1rem 1.5rem 1.5rem;">
                {% if existingApplication is defined and existingApplication %}
                    {% if existingApplication.statut == 'pending' %}
                    <div style="background:#fff9e6; border:1px solid #f6c84a; border-radius:12px; padding:14px; text-align:center; margin-bottom:10px;">
                        <i class="fa-solid fa-clock" style="color:#f6c84a; font-size:1.5rem; display:block; margin-bottom:6px;"></i>
                        <strong style="color:#856404;">Candidature en attente</strong>
                        <p style="color:#856404; font-size:12px; margin:4px 0 0;">Envoyée le {{ existingApplication.createdAt|date('d/m/Y') }}</p>
                    </div>
                    <a href="{{ path('app_tenant_application_show', {id: existingApplication.id}) }}"
                       class="pd-btn-apply" style="background:linear-gradient(135deg,#f6c84a,#e0a800); text-decoration:none; display:flex; justify-content:center;">
                        <i class="fa-solid fa-eye me-2"></i> Voir ma candidature
                    </a>
                    {% elseif existingApplication.statut == 'accepted' %}
                    <div style="background:#e6f9f0; border:1px solid #28a745; border-radius:12px; padding:14px; text-align:center; margin-bottom:10px;">
                        <i class="fa-solid fa-circle-check" style="color:#28a745; font-size:1.5rem; display:block; margin-bottom:6px;"></i>
                        <strong style="color:#155724;">Candidature acceptée !</strong>
                    </div>
                    <a href="{{ path('app_tenant_application_show', {id: existingApplication.id}) }}"
                       class="pd-btn-apply" style="background:linear-gradient(135deg,#28a745,#1e7e34); text-decoration:none; display:flex; justify-content:center;">
                        <i class="fa-solid fa-calendar-check me-2"></i> Voir les détails
                    </a>
                    {% else %}
                    <button type="button" class="pd-btn-apply" data-bs-toggle="modal" data-bs-target="#applyModal">
                        <i class="fa-solid fa-paper-plane me-2"></i> Postuler à ce bien
                    </button>
                    {% endif %}
                {% else %}
                <button type="button" class="pd-btn-apply" data-bs-toggle="modal" data-bs-target="#applyModal">
                    <i class="fa-solid fa-paper-plane me-2"></i> Postuler à ce bien
                </button>
                {% endif %}
                <p style="text-align:center; font-size:11px; color:#999; margin-top:10px;">
                    <i class="fa-solid fa-shield-check" style="color:#27ae60;"></i> Réponse sous 24/48h garantie
                </p>

                <div class="d-flex gap-2 mt-2">
                    <form method="POST" action="{{ path('app_tenant_favorite_toggle', {propertyId: property.id}) }}" style="flex:1;">
                        <button type="submit" class="pd-btn-secondary w-100">
                            <i class="fa-{{ isFavorite ? 'solid' : 'regular' }} fa-heart" style="color:{{ isFavorite ? '#e74c3c' : 'inherit' }};"></i>
                            {{ isFavorite ? 'Favori' : 'Favoris' }}
                        </button>
                    </form>
                    <button onclick="shareProperty()" class="pd-btn-secondary" style="flex:1;">
                        <i class="fa-solid fa-share-nodes"></i> Partager
                    </button>
                </div>
            </div>
        </div>

        {# Résumé infos clés #}
        <div class="pd-sidebar-card mb-3">
            <div style="padding: 1.2rem;">
                <div class="pd-sidebar-section-title">Infos clés</div>
                <div class="pd-kv-list">
                    {% if property.deposit %}<div class="pd-kv"><span>Caution</span><strong>{{ property.deposit|number_format(0, ',', ' ') }} F</strong></div>{% endif %}
                    {% if property.disponibilite %}<div class="pd-kv"><span>Disponible</span><strong>{{ property.disponibilite }}</strong></div>{% endif %}
                    {% if property.dureeMinLocation %}<div class="pd-kv"><span>Durée min.</span><strong>{{ property.dureeMinLocation }} mois</strong></div>{% endif %}
                    {% if property.preavis %}<div class="pd-kv"><span>Préavis</span><strong>{{ property.preavis }} mois</strong></div>{% endif %}
                    <div class="pd-kv"><span>Vues</span><strong>{{ property.views }}</strong></div>
                    <div class="pd-kv"><span>Publié le</span><strong>{{ property.createdAt|date('d/m/Y') }}</strong></div>
                </div>
            </div>
        </div>

        {# Propriétaire #}
        <div class="pd-sidebar-card mb-3">
            <div style="padding: 1.2rem;">
                <div class="pd-sidebar-section-title">Propriétaire</div>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="pd-owner-avatar">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>
                    <div>
                        <div style="font-weight: 700; color: #2c3e50; font-size: 15px;">{{ proprietaire.fullName }}</div>
                        {% if proprietaire.verificationStatus == 'certifie' %}
                        <span class="pd-certified"><i class="fa-solid fa-circle-check me-1"></i>Certifié</span>
                        {% endif %}
                        <div class="pd-stars mt-1" style="font-size:13px;">
                            {% for i in 1..5 %}<i class="fa-{{ i <= (avgRating|round) ? 'solid' : 'regular' }} fa-star" style="color:#f39c12;"></i>{% endfor %}
                            <span style="color:#888; font-size:12px; margin-left:4px;">{{ avgRating|number_format(1) }} ({{ reviews|length }})</span>
                        </div>
                    </div>
                </div>
                <a href="{{ path('app_tenant_messages') }}" class="pd-btn-secondary w-100" style="display:block; text-align:center;">
                    <i class="fa-solid fa-headset me-2"></i> Contacter l'Admin
                </a>
            </div>
        </div>

    </div>
</div>
</div>

{# ══════════════════ BIENS SIMILAIRES ═════════════════════════════════ #}
{% if similarProperties is defined and similarProperties|length > 0 %}
<div class="pd-similar mt-5">
    <h3 class="pd-similar-title">Biens similaires</h3>
    <div class="row g-4">
        {% for sim in similarProperties %}
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_tenant_property_show', {id: sim.id}) }}" class="pd-sim-card text-decoration-none">
                <div class="pd-sim-img">
                    {% if sim.images and sim.images|length > 0 %}
                        {% set s0 = sim.images[0] %}
                        <img src="{{ s0 starts with 'http' or s0 starts with 'data:' ? s0 : asset('uploads/properties/' ~ s0) }}" alt="{{ sim.title }}">
                    {% else %}
                        <div class="pd-sim-no-img"><i class="fa-solid fa-house"></i></div>
                    {% endif %}
                    {% if sim.type %}<span class="pd-sim-type">{{ sim.type|capitalize }}</span>{% endif %}
                </div>
                <div class="pd-sim-body">
                    <div class="pd-sim-price">{{ sim.pricePerMonth|number_format(0, ',', ' ') }} <small>FCFA/mois</small></div>
                    <div class="pd-sim-name">{{ sim.title|slice(0, 40) }}{% if sim.title|length > 40 %}…{% endif %}</div>
                    <div class="pd-sim-loc"><i class="fa-solid fa-location-dot me-1"></i>{{ sim.city }}</div>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

</div>{# .pd-wrap #}

{# Lightbox et modaux déplacés dans body_end #}

