}
.react-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: #f4f4f6; border: 1px solid #e0e0e4;
    color: #555; border-radius: 50px; padding: 8px 18px; font-size: 13px;
    font-weight: 600; cursor: pointer; transition: all .2s;
}
.react-btn:hover { background: #eef2ff; color: #667eea; border-color: #c5cff5; }
.react-active-like  { background: rgba(37,211,102,0.12) !important; color: #1a9e4c !important; border-color: rgba(37,211,102,0.4) !important; }
.react-active-dislike { background: rgba(231,76,60,0.12) !important; color: #c0392b !important; border-color: rgba(231,76,60,0.4) !important; }
.react-report { color: #e67e22 !important; border-color: rgba(230,126,34,0.35) !important; }
.react-report:hover { background: rgba(230,126,34,0.1) !important; color: #c96d0f !important; }

/* ══ Commentaires ════════════════════════════════════════════════ */
.comment-count-badge {
    background: #667eea; color: #fff; border-radius: 50px;
    font-size: 10px; padding: 1px 8px; font-weight: 700; margin-left: 6px;
}
.comment-form-wrap { display: flex; gap: 12px; align-items: flex-start; }
.comment-self-av {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #667eea, #FF4B5C);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 14px;
}
.comment-input-area { flex: 1; }
.comment-input-area textarea {
    width: 100%; background: #f8f9fa;
    border: 1px solid #dee2e6; border-radius: 12px;
    color: #333; padding: 10px 14px; font-size: 13px; resize: none;
    font-family: inherit; transition: border-color .2s; outline: none;
}
.comment-input-area textarea:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.12); }
.comment-input-area textarea::placeholder { color: #b0b0b8; }
.comment-submit-btn {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff; border: none; border-radius: 50px;
    padding: 7px 20px; font-size: 13px; font-weight: 700; cursor: pointer;
    transition: all .2s;
}
.comment-submit-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(102,126,234,0.4); }

.comment-item { display: flex; gap: 12px; margin-bottom: 16px; }
.comment-av {
    width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #0652DD, #00D2FF);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 13px;
}
.comment-body { flex: 1; }
.comment-header {
    display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;
}
.comment-header strong { color: #2c3e50; font-size: 13px; }
.comment-date { font-size: 11px; color: #aaa; }
.comment-delete-btn {
    background: none; border: none; color: #e74c3c; cursor: pointer;
    font-size: 12px; padding: 2px 6px; border-radius: 6px; transition: background .2s;
}
.comment-delete-btn:hover { background: rgba(231,76,60,0.1); }
.comment-text { color: #555; font-size: 13px; line-height: 1.55; margin: 0; }
.comment-empty { text-align: center; padding: 2rem; color: #bbb; }
.comment-empty i { font-size: 2rem; display: block; margin-bottom: 8px; color: #ddd; }
.comment-empty p { font-size: 13px; margin: 0; }

/* ══ Modal Signalement ═══════════════════════════════════════════ */
.report-modal-box {
    background: #1C1C2E; border: 1px solid rgba(231,76,60,0.25);
    border-radius: 20px; width: 100%; max-width: 480px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    animation: modalFadeIn .25s ease;
}
@keyframes modalFadeIn { from{transform:scale(.92);opacity:0;} to{transform:scale(1);opacity:1;} }
.report-modal-head {
    display: flex; align-items: center; gap: 12px;
    padding: 1.2rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.07);
}
.report-modal-head h5 { color: #fff; font-size: 1rem; }
.report-modal-body { padding: 1.5rem; }
.report-label {
    display: block; font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: rgba(255,255,255,0.5); margin-bottom: 8px;
}
.report-select, .report-textarea {
    width: 100%; background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1); border-radius: 10px;
    color: #fff; padding: 10px 14px; font-size: 13px; font-family: inherit;
    outline: none; transition: border-color .2s;
}
.report-select:focus, .report-textarea:focus { border-color: rgba(231,76,60,0.5); }
.report-select option { background: #1C1C2E; color: #fff; }
.report-textarea { resize: none; }
.priority-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.priority-option {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 14px; border-radius: 10px; cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1); font-size: 13px; font-weight: 600;
    transition: all .2s; color: rgba(255,255,255,0.6);
}
.priority-option input[type="radio"] { display: none; }
.prio-low:has(input:checked)      { background:rgba(148,163,184,0.15); color:#94a3b8; border-color:rgba(148,163,184,0.4); }
.prio-medium:has(input:checked)   { background:rgba(255,193,7,0.15);   color:#ffc107; border-color:rgba(255,193,7,0.4); }
.prio-high:has(input:checked)     { background:rgba(230,126,34,0.15);  color:#e67e22; border-color:rgba(230,126,34,0.4); }
.prio-critical:has(input:checked) { background:rgba(231,76,60,0.15);   color:#e74c3c; border-color:rgba(231,76,60,0.4); }
.priority-option:hover { background: rgba(255,255,255,0.05); color: #fff; }
.report-submit-btn {
    width: 100%; background: linear-gradient(135deg, #e74c3c, #c0392b);
    color: #fff; border: none; border-radius: 50px; padding: 13px;
    font-size: 14px; font-weight: 700; cursor: pointer; transition: all .2s;
    box-shadow: 0 4px 14px rgba(231,76,60,0.4);
}
.report-submit-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(231,76,60,0.6); }
</style>

<script>
function updateCharCount(el) {
    document.getElementById('charCount').textContent = el.value.length + ' / 500';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.getElementById('reportModal').style.display = 'none';
    }
});
</script>
{% endblock %}
