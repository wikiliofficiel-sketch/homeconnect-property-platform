{% extends 'tenant/base.html.twig' %}

{% block tenant_content %}
<div class="favorites-container">
    <div class="page-header mb-5 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold" style="color: #2c3e50; font-family: var(--f-serif);"><i class="fa-solid fa-heart text-danger"></i> Mes Coups de Cœur</h1>
            <p class="text-muted mb-0">Retrouvez ici tous les biens qui ont retenu votre attention.</p>
        </div>
        <div class="stats-badge bg-white shadow-sm border rounded-pill px-4 py-2 fw-bold text-dark">
            <span class="text-danger me-2">{{ favorites|length }}</span> Favoris enregistrés
        </div>
    </div>

    {% if favorites|length > 0 %}
        <div class="row g-4" id="favoritesGrid">
            {% for favorite in favorites|default(1..3) %}
                <div class="col-md-6 col-xl-4 favorite-item-container">
                    <div class="favorite-card-modern bg-white rounded-4 shadow-sm border overflow-hidden h-100 position-relative">
                        <!-- Image avec overlay -->
                        <!-- Image avec overlay -->
                        <div class="card-img-wrapper position-relative">
                            {% if favorite.property.images and favorite.property.images|length > 0 %}
                                {% set fimg = favorite.property.images[0] %}
                                <img src="{{ (fimg starts with 'http' or fimg starts with 'data:') ? fimg : asset('uploads/properties/' ~ fimg) }}" class="img-fluid w-100" style="height: 220px; object-fit: cover;" alt="{{ favorite.property.title }}">
                            {% else %}
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light" style="height: 220px;">
                                    <i class="fa-solid fa-house fs-1 text-secondary opacity-25"></i>
                                </div>
                            {% endif %}
                            <div class="status-overlay position-absolute top-0 start-0 m-3 d-flex flex-column gap-2">
                                <span class="badge bg-white text-dark shadow-sm px-3 py-2 rounded-pill fw-bold"><i class="fa-solid fa-check-circle text-success"></i> {{ favorite.property.statut|default('Disponible') }}</span>
                                <span class="badge bg-danger text-white shadow-sm px-3 py-2 rounded-pill fw-bold"><i class="fa-solid fa-bolt"></i> Coup de cœur</span>
                            </div>
                            <form method="POST" action="{{ path('app_tenant_favorite_toggle', {propertyId: favorite.property.id}) }}" class="position-absolute top-0 end-0 m-3">
                                <button type="submit" class="btn btn-white rounded-circle shadow p-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" title="Retirer des favoris">
                                    <i class="fa-solid fa-heart-crack text-muted fs-5"></i>
                                </button>
                            </form>
                        </div>

                        <!-- Contenu -->
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="h5 fw-bold text-dark mb-0 text-truncate">{{ favorite.property.title }}</h3>
                                <div class="price-tag text-primary fw-bold fs-5">
                                    {{ favorite.property.pricePerMonth|number_format(0, ',', ' ') }} <small class="fs-6 fw-normal text-muted">FCFA</small>
                                </div>
                            </div>
                            <p class="text-muted small mb-3"><i class="fa-solid fa-location-dot me-1"></i> {{ favorite.property.city }}, {{ favorite.property.address }}</p>
                            
                            <div class="features-row d-flex gap-4 border-top border-bottom py-3 mb-4">
                                <div class="feature-item text-center flex-grow-1">
                                    <i class="fa-solid fa-bed text-muted d-block mb-1"></i>
                                    <span class="small fw-bold">{{ favorite.property.bedrooms }} Ch.</span>
                                </div>
                                <div class="feature-item text-center flex-grow-1 border-start border-end">
                                    <i class="fa-solid fa-bath text-muted d-block mb-1"></i>
                                    <span class="small fw-bold">2 SdB.</span>
                                </div>
                                <div class="feature-item text-center flex-grow-1">
                                    <i class="fa-solid fa-ruler-combined text-muted d-block mb-1"></i>
                                    <span class="small fw-bold">{{ favorite.property.surface }} m²</span>
                                </div>
                            </div>

                            <div class="actions-footer d-grid gap-2">
                                <a href="{{ path('app_tenant_property_show', {id: favorite.property.id}) }}" class="btn btn-outline-primary rounded-pill fw-bold py-2">
                                    <i class="fa-solid fa-eye me-1"></i> Consulter l'annonce
                                </a>
                                <button class="btn btn-primary rounded-pill fw-bold py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#applyModal{{ favorite.property.id }}">
                                    <i class="fa-solid fa-paper-plane me-1"></i> Postuler maintenant
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-favorites text-center py-5 bg-white rounded-5 border shadow-sm">
            <div class="mb-4">
                <i class="fa-solid fa-heart-circle-xmark text-muted opacity-25" style="font-size: 5rem;"></i>
            </div>
            <h3 class="fw-bold text-dark">Votre liste est vide</h3>
            <p class="text-muted mb-4">Parcourez nos annonces et cliquez sur le cœur pour les retrouver ici.</p>
            <a href="{{ path('app_tenant_search')|default('#') }}" class="btn btn-primary btn-lg px-5 rounded-pill shadow">
                <i class="fa-solid fa-magnifying-glass me-2"></i> Explorer les annonces
            </a>
        </div>
    {% endif %}
</div>

<style>
.favorite-card-modern { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); border-color: transparent !important; }
.favorite-card-modern:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important; border-color: #ff4757 !important; }

.card-img-wrapper { height: 220px; }
.card-img-wrapper img { transition: transform 0.5s; }
.favorite-card-modern:hover .card-img-wrapper img { transform: scale(1.1); }

.status-overlay .badge { font-size: 0.75rem; border: none; }

.feature-item i { font-size: 1.1rem; }
.feature-item span { color: #2c3e50; }

.btn-white { background: #fff; color: #2c3e50; }
.btn-white:hover { background: #ff4757; color: #fff; }

.empty-favorites { border-style: dashed !important; border-width: 2px !important; }
</style>
{% endblock %}
