{% extends 'tenant/base.html.twig' %}

{% block tenant_content %}
<div class="contracts-container">
    <div class="page-header mb-5 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold" style="color: #2c3e50; font-family: var(--f-serif);"><i class="fa-solid fa-file-contract text-primary"></i> Mes Contrats & États des lieux</h1>
            <p class="text-muted mb-0">Consultez vos baux signés et gérez vos états des lieux.</p>
        </div>
    </div>

    <!-- Liste des Contrats -->
    <div class="row g-4 mb-5">
        {% for contract in rentals %}
            <div class="col-12">
                <div class="contract-card bg-white p-4 rounded-5 shadow-sm border d-flex flex-wrap align-items-center gap-4">
                    <div class="contract-icon bg-primary-subtle text-primary rounded-4 p-3">
                        <i class="fa-solid fa-file-contract fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="fw-bold mb-1">Contrat de Bail - {{ contract.property.title }}</h4>
                        <p class="text-muted small mb-0">Signé le {{ contract.startDate|date('d/m/Y') }} • Loyer : {{ contract.monthlyPrice|number_format(0, ',', ' ') }} FCFA/mois</p>
                        
                        {% set penalty = contract.calculatePenalty %}
                        {% if penalty > 0 %}
                            <div class="alert alert-warning py-1 px-2 mt-2 mb-0 d-inline-block small rounded-pill">
                                <i class="fa-solid fa-triangle-exclamation"></i> 
                                Retard détecté : +{{ penalty|number_format(0, ',', ' ') }} FCFA de pénalité
                            </div>
                        {% endif %}
                    </div>
                    <div class="contract-actions d-flex gap-2">
                        {% if contract.isPaid %}
                            <div class="d-flex flex-column gap-1">
                                <span class="badge bg-success-subtle text-success rounded-pill px-4 py-2 d-flex align-items-center mb-1">
                                    <i class="fa-solid fa-check-circle me-1"></i> Payé
                                </span>
                                {% set lastPayment = contract.payments|filter(p => p.status == 'success')|last %}
                                {% if lastPayment %}
                                    <a href="{{ path('app_tenant_payment_receipt', {id: lastPayment.id}) }}" class="btn btn-sm btn-outline-success rounded-pill fw-bold" target="_blank">
                                        <i class="fa-solid fa-file-invoice me-1"></i> Ma Quittance
                                    </a>
                                {% endif %}
                            </div>
                        {% else %}
                            <a href="{{ path('app_tenant_payment_initiate', {id: contract.id}) }}" class="btn btn-success rounded-pill fw-bold px-4 shadow-sm">
                                <i class="fa-solid fa-credit-card me-1"></i> Payer le loyer
                            </a>
                        {% endif %}
                        <a href="{{ path('app_owner_contract_generate', {id: contract.id}) }}" class="btn btn-outline-primary rounded-pill fw-bold px-4" target="_blank">
                            <i class="fa-solid fa-file-pdf me-1"></i> PDF
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- État des lieux interactif -->
    <div class="card border-0 shadow-sm rounded-5 overflow-hidden mb-5">
        <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0"><i class="fa-solid fa-clipboard-check text-success me-2"></i> État des Lieux d'entrée</h4>
            <span class="badge bg-success-subtle text-success rounded-pill">En cours</span>
        </div>
        <div class="card-body p-4">
            <p class="text-muted small mb-4">Évaluez l'état de chaque pièce et ajoutez des photos si nécessaire.</p>
            
            <div class="room-list">
                {% set rooms = ['Salon', 'Chambre Principale', 'Cuisine', 'Salle de Bain'] %}
                {% for room in rooms %}
                    <div class="room-item p-4 rounded-4 border mb-3 bg-light-hover">
                        <div class="row align-items-center g-3">
                            <div class="col-md-4">
                                <h5 class="fw-bold mb-0">{{ room }}</h5>
                            </div>
                            <div class="col-md-4">
                                <select class="form-select rounded-pill border-light shadow-sm">
                                    <option value="5">Excellent (Neuf)</option>
                                    <option value="4">Très Bon État</option>
                                    <option value="3">Bon État</option>
                                    <option value="2">État d'usage</option>
                                    <option value="1">Mauvais État</option>
                                </select>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <button class="btn btn-light rounded-pill btn-sm fw-bold border" onclick="triggerUpload('{{ room|replace({' ': '-'})|lower }}')">
                                    <i class="fa-solid fa-camera me-1"></i> Ajouter une photo
                                </button>
                                <input type="file" id="file-{{ room|replace({' ': '-'})|lower }}" class="d-none" onchange="previewImage(this)">
                            </div>
                        </div>
                        <div class="photo-preview mt-3 d-flex gap-2" id="preview-{{ room|replace({' ': '-'})|lower }}"></div>
                    </div>
                {% endfor %}
            </div>

            <div class="text-end mt-4">
                <button class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow" onclick="saveEtatDesLieux()">
                    <i class="fa-solid fa-save me-2"></i> Enregistrer l'état des lieux
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Aperçu PDF -->
<div class="modal fade" id="pdfModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-5 border-0 shadow-lg">
            <div class="modal-header border-0 p-4">
                <h4 class="modal-title fw-bold">Aperçu du Contrat</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 pt-0">
                <div class="pdf-mockup bg-light rounded-4 p-5 text-center border" style="min-height: 400px;">
                    <i class="fa-solid fa-file-pdf display-1 text-danger opacity-25 mb-4"></i>
                    <h5 class="fw-bold">CONTRAT DE BAIL À USAGE D'HABITATION</h5>
                    <hr class="w-25 mx-auto">
                    <p class="text-start mt-4 small text-muted">
                        Entre les soussignés :<br>
                        <strong>M. Jean-Marc B.</strong> (Bailleur)<br>
                        Et<br>
                        <strong>{{ app.user.fullName }}</strong> (Preneur)<br><br>
                        Il a été convenu ce qui suit...
                    </p>
                </div>
                <div class="mt-4 text-center">
                    <button class="btn btn-primary rounded-pill px-5 fw-bold" onclick="window.print()">
                        <i class="fa-solid fa-print me-2"></i> Imprimer / Enregistrer
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function previewPDF() {
    new bootstrap.Modal(document.getElementById('pdfModal')).show();
}

function downloadPDF() {
    alert('Génération du PDF en cours... Le téléchargement commencera sous peu.');
}

function triggerUpload(id) {
    document.getElementById('file-' + id).click();
}

function previewImage(input) {
    const id = input.id.split('-')[1];
    const previewContainer = document.getElementById('preview-' + id);
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = document.createElement('img');
            img.src = e.target.result;
            img.className = 'rounded-3 shadow-sm border';
            img.style.width = '80px';
            img.style.height = '60px';
            img.style.objectFit = 'cover';
            previewContainer.appendChild(img);
        }
        reader.readAsDataURL(input.files[0]);
    }
}

function saveEtatDesLieux() {
    alert('État des lieux enregistré avec succès ! Un récapitulatif a été envoyé au bailleur.');
}
</script>

<style>
.contract-card { transition: transform 0.2s; }
.contract-card:hover { transform: scale(1.01); }
.bg-light-hover:hover { background: #f8f9fa !important; border-color: #686de0 !important; }
.pdf-mockup { font-family: 'Times New Roman', serif; }
</style>
{% endblock %}
