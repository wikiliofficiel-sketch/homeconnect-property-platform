              <i class="fa-regular fa-eye"></i>
            </button>
          </div>
          <div class="pw-bars">
            <div class="pw-bar" id="pb1"></div><div class="pw-bar" id="pb2"></div>
            <div class="pw-bar" id="pb3"></div><div class="pw-bar" id="pb4"></div>
          </div>
          <div class="pw-label" id="pw-label">{{ 'public.register.password_strength'|trans }}</div>
          {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <div class="check-row">
          {{ form_widget(registrationForm.agreeTerms) }}
          <label for="{{ registrationForm.agreeTerms.vars.id }}">
            {{ 'public.register.agree'|trans }} <a href="{{ path('app_home') }}" target="_blank">{{ 'public.footer.cgu'|trans }}</a>
            {{ 'public.register.and_the'|trans }} <a href="{{ path('app_home') }}" target="_blank">{{ 'public.footer.privacy'|trans }}</a> de HomeConnect
          </label>
        </div>
        {{ form_errors(registrationForm.agreeTerms) }}

        <div class="btn-row">
          <button type="button" class="btn-back" onclick="goStep(1)">
            <i class="fa-solid fa-arrow-left"></i> Retour
          </button>
          {# Locataire → soumettre directement ; Propriétaire → aller à l'étape KYC #}
          <button type="button" class="btn-submit" id="btnStep2Submit" onclick="handleStep2Submit()">
            Continuer <i class="fa-solid fa-arrow-right"></i>
