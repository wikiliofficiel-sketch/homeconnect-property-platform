        </div>

      {{ form_end(registrationForm) }}
    </div>

    {# ÉTAPE 3 — Documents KYC (propriétaire uniquement) #}
    <div class="reg-step" id="step-3">
      <div class="step-header">
        <h3><i class="fa-solid fa-shield-halved" style="color:var(--wine);"></i> Vérification d'identité (KYC)</h3>
        <p>Téléchargez vos documents pour activer votre compte propriétaire. L'administrateur les validera sous 24–48h.</p>
      </div>

      <form id="kycForm" action="{{ path('app_register') }}" method="POST" enctype="multipart/form-data">
        {# Données du step 2 transmises en hidden #}
        <input type="hidden" id="kyc_email"     name="email">
        <input type="hidden" id="kyc_prenom"    name="prenom">
        <input type="hidden" id="kyc_nom"       name="nom">
        <input type="hidden" id="kyc_telephone" name="telephone">
        <input type="hidden" id="kyc_ville"     name="ville">
        <input type="hidden" id="kyc_password"  name="password">
        <input type="hidden" name="role" value="proprietaire">

        {# ── 1. Pièce d'identité ── #}
        <div class="kyc-section">
          <div class="kyc-section-title">
            <i class="fa-solid fa-id-card text-wine"></i>
            1. Pièce d'identité valide <span class="req">*</span>
          </div>
          <div class="form-row-2" style="margin-bottom:8px;">
            <label class="kyc-radio-label">
              <input type="radio" name="kyc_identite_type" value="cni" checked>
              <span><i class="fa-solid fa-id-card me-1"></i> Carte Nationale d'Identité (CNI)</span>
            </label>
            <label class="kyc-radio-label">
              <input type="radio" name="kyc_identite_type" value="passeport">
              <span><i class="fa-solid fa-passport me-1"></i> Passeport</span>
            </label>
          </div>
          <div class="kyc-upload-zone" onclick="document.getElementById('kyc_identite').click()">
            <input type="file" id="kyc_identite" name="kyc_identite" accept=".jpg,.jpeg,.png,.pdf" required style="display:none" onchange="previewFile(this,'prev_identite')">
            <div id="prev_identite" class="kyc-preview-empty">
              <i class="fa-solid fa-cloud-arrow-up fa-2x" style="color:var(--wine);opacity:.7;"></i>
              <p>Cliquez pour uploader ou glissez-déposez</p>
              <small>JPG, PNG, PDF — max 5 Mo</small>
            </div>
          </div>
        </div>

        {# ── 2. Justificatif de domicile ── #}
        <div class="kyc-section">
          <div class="kyc-section-title">
            <i class="fa-solid fa-house-chimney text-wine"></i>
            2. Justificatif de domicile (- de 3 mois) <span class="req">*</span>
          </div>
          <select name="kyc_domicile_type" class="kyc-select">
            <option value="electricite">Facture d'électricité</option>
            <option value="eau">Facture d'eau</option>
            <option value="telephone">Facture de téléphone</option>
            <option value="taxe_fonciere">Avis de taxe foncière</option>
            <option value="quittance">Quittance de loyer</option>
          </select>
          <div class="kyc-upload-zone" onclick="document.getElementById('kyc_domicile').click()">
            <input type="file" id="kyc_domicile" name="kyc_domicile" accept=".jpg,.jpeg,.png,.pdf" required style="display:none" onchange="previewFile(this,'prev_domicile')">
            <div id="prev_domicile" class="kyc-preview-empty">
              <i class="fa-solid fa-cloud-arrow-up fa-2x" style="color:var(--wine);opacity:.7;"></i>
              <p>Cliquez pour uploader</p>
              <small>JPG, PNG, PDF — max 5 Mo</small>
            </div>
          </div>
        </div>

        {# ── 3. Justificatif de propriété ── #}
        <div class="kyc-section">
          <div class="kyc-section-title">
            <i class="fa-solid fa-file-contract text-wine"></i>
            3. Justificatif de propriété du bien <span class="req">*</span>
          </div>
          <select name="kyc_propriete_type" class="kyc-select">
            <option value="titre_foncier">Titre foncier</option>
            <option value="attestation_notaire">Attestation de propriété (notaire)</option>
            <option value="acte_vente">Acte de vente authentique</option>
            <option value="donation_succession">Acte de donation ou de succession</option>
          </select>
          <div class="kyc-upload-zone" onclick="document.getElementById('kyc_propriete').click()">
            <input type="file" id="kyc_propriete" name="kyc_propriete" accept=".jpg,.jpeg,.png,.pdf" required style="display:none" onchange="previewFile(this,'prev_propriete')">
            <div id="prev_propriete" class="kyc-preview-empty">
              <i class="fa-solid fa-cloud-arrow-up fa-2x" style="color:var(--wine);opacity:.7;"></i>
              <p>Cliquez pour uploader</p>
              <small>JPG, PNG, PDF — max 5 Mo</small>
            </div>
          </div>
        </div>

        {# ── Optionnels ── #}
        <details class="kyc-optional">
          <summary><i class="fa-solid fa-circle-plus me-2" style="color:var(--wine);"></i>Documents complémentaires (recommandés, facultatifs)</summary>
          <div style="margin-top:14px;">
            <div class="kyc-section" style="border:1px dashed rgba(108,92,231,.3);">
              <div class="kyc-section-title" style="font-size:.85rem;">
                <i class="fa-solid fa-building-columns text-wine"></i> RIB (Relevé d'Identité Bancaire)
              </div>
              <div class="kyc-upload-zone small" onclick="document.getElementById('kyc_rib').click()">
                <input type="file" id="kyc_rib" name="kyc_rib" accept=".jpg,.jpeg,.png,.pdf" style="display:none" onchange="previewFile(this,'prev_rib')">
                <div id="prev_rib" class="kyc-preview-empty"><i class="fa-solid fa-cloud-arrow-up"></i> <small>Uploader le RIB</small></div>
              </div>
            </div>
            <div class="kyc-section" style="border:1px dashed rgba(108,92,231,.3);">
              <div class="kyc-section-title" style="font-size:.85rem;">
                <i class="fa-solid fa-shield text-wine"></i> Attestation d'assurance PNO
              </div>
              <div class="kyc-upload-zone small" onclick="document.getElementById('kyc_assurance').click()">
                <input type="file" id="kyc_assurance" name="kyc_assurance" accept=".jpg,.jpeg,.png,.pdf" style="display:none" onchange="previewFile(this,'prev_assurance')">
                <div id="prev_assurance" class="kyc-preview-empty"><i class="fa-solid fa-cloud-arrow-up"></i> <small>Uploader l'attestation</small></div>
              </div>
            </div>
          </div>
        </details>

        {# ── Cas particuliers ── #}
        <details class="kyc-optional">
          <summary><i class="fa-solid fa-building me-2" style="color:var(--wine);"></i>Cas particuliers (Copropriété / SCI)</summary>
          <div style="margin-top:14px;">
            <div class="form-row-2" style="margin-bottom:12px;">
              <label class="kyc-radio-label">
                <input type="radio" name="kyc_cas_particulier_type" value="copropriete">
                <span>Copropriété</span>
              </label>
              <label class="kyc-radio-label">
                <input type="radio" name="kyc_cas_particulier_type" value="sci">
                <span>SCI (Société Civile Immobilière)</span>
              </label>
            </div>
            <div class="kyc-upload-zone small" onclick="document.getElementById('kyc_cas_particulier').click()">
              <input type="file" id="kyc_cas_particulier" name="kyc_cas_particulier" accept=".jpg,.jpeg,.png,.pdf" style="display:none" onchange="previewFile(this,'prev_cas')">
              <div id="prev_cas" class="kyc-preview-empty"><i class="fa-solid fa-cloud-arrow-up"></i> <small>Document copropriété / statuts SCI</small></div>
            </div>
          </div>
        </details>

        {# Statut info #}
        <div class="kyc-status-info">
          <i class="fa-solid fa-clock-rotate-left me-2"></i>
          Après envoi, l'administrateur examine vos documents.
          Statut : <strong>en_attente</strong> → <strong>certifié</strong> (ou <strong>rejeté</strong> avec motif).
          Seul un compte certifié peut publier des biens et afficher le badge de confiance.
        </div>

        <div class="btn-row">
          <button type="button" class="btn-back" onclick="goStep(2)">
            <i class="fa-solid fa-arrow-left"></i> Retour
          </button>
          <button type="submit" class="btn-submit" id="kycSubmitBtn">
            <i class="fa-solid fa-paper-plane"></i> Créer mon compte
          </button>
        </div>
      </form>
    </div>

  </div>
</section>

{% include 'partials/_footer.html.twig' %}

<script>

  // ── Rôle courant (initialisé au chargement) ──────────────────────────────
  let currentRole = 'proprietaire';

  function selectRole(key) {
    document.getElementById('rc-prop').classList.remove('selected');
    document.getElementById('rc-loc').classList.remove('selected');
    document.getElementById('rc-' + key).classList.add('selected');
    currentRole = key === 'prop' ? 'proprietaire' : 'locataire';

    const rf = document.getElementById('hidden_role');
    if (rf) rf.value = currentRole;

    // Afficher / masquer l'indicateur KYC dans la barre de progression
    const kycEls = document.querySelectorAll('.step-kyc');
    kycEls.forEach(el => el.style.display = (currentRole === 'proprietaire') ? '' : 'none');
  }

  function goStep(n) {
    document.querySelectorAll('.reg-step').forEach((el, i) => el.classList.toggle('active', i + 1 === n));
    for (let i = 1; i <= 3; i++) {
      const dot = document.getElementById('sdot-' + i);
      if (!dot) continue;
      dot.className = 'step-dot';
      if (i < n)      { dot.classList.add('done'); dot.innerHTML = '<i class="fa-solid fa-check" style="font-size:10px;"></i>'; }
      else if (i === n) { dot.classList.add('active'); dot.textContent = i; }
      else              { dot.textContent = i; }
      const l = document.getElementById('sline-' + i);
      if (l) l.classList.toggle('done', i < n);
    }
  }

  // Interception centrale : Entrée dans un champ OU clic sur le bouton "Continuer"
  function handleStep2Submit() {
    if (currentRole === 'locataire') {
      document.getElementById('regForm').submit();
      return;
    }
    // Propriétaire → transférer les données vers le formulaire KYC
    const f = document.getElementById('regForm');
    document.getElementById('kyc_email').value     = f.querySelector('[name$="[email]"]')?.value || '';
    document.getElementById('kyc_prenom').value    = f.querySelector('[name$="[prenom]"]')?.value || '';
    document.getElementById('kyc_nom').value       = f.querySelector('[name$="[nom]"]')?.value || '';
    document.getElementById('kyc_telephone').value = f.querySelector('[name$="[telephone]"]')?.value || '';
    document.getElementById('kyc_ville').value     = f.querySelector('[name$="[ville]"]')?.value || '';
    document.getElementById('kyc_password').value  = f.querySelector('#reg_password')?.value || '';
    goStep(3);
  }

  function togglePw(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('i');
    input.type = input.type === 'password' ? 'text' : 'password';
    icon.classList.toggle('fa-eye', input.type === 'password');
    icon.classList.toggle('fa-eye-slash', input.type === 'text');
  }

  function checkStrength(val) {
    let score = 0;
    if (val.length >= 8) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    ['pb1','pb2','pb3','pb4'].forEach((id, i) => {
      const el = document.getElementById(id);
      el.className = 'pw-bar';
      if (i < score) el.classList.add(score <= 1 ? 'weak' : score <= 2 ? 'medium' : 'strong');
    });
    const lbl = document.getElementById('pw-label');
    lbl.textContent = val.length ? (['','Faible','Moyen','Bon','Excellent'][score]||'Excellent') : 'Force du mot de passe';
  }

  function otpNext(input, idx) {
    input.value = input.value.replace(/\D/g, '');
    const all = document.querySelectorAll('.otp-input');
    if (input.value && idx < all.length - 1) all[idx + 1].focus();
  }
  document.querySelectorAll('.otp-input').forEach((inp, idx) => {
    inp.addEventListener('keydown', e => { if (e.key==='Backspace' && !inp.value && idx>0) document.querySelectorAll('.otp-input')[idx-1].focus(); });
    inp.addEventListener('paste', e => {
      const d = (e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'').split('');
      document.querySelectorAll('.otp-input').forEach((ci,i)=>{ if(d[i]) ci.value=d[i]; });
      e.preventDefault();
    });
  });

  // ── Aperçu fichier uploadé ────────────────────────────────────────────────
  function previewFile(input, previewId) {
    const preview = document.getElementById(previewId);
    if (!preview) return;
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const sizeMb = (file.size / 1024 / 1024).toFixed(1);
      if (file.size > 5 * 1024 * 1024) {
        preview.innerHTML = '<span style="color:var(--accent)"><i class="fa-solid fa-triangle-exclamation"></i> Fichier trop lourd (max 5 Mo)</span>';
        input.value = '';
        return;
      }
      const icon = file.type.includes('pdf') ? 'fa-file-pdf' : 'fa-file-image';
      preview.className = 'kyc-preview-done';
      preview.innerHTML = `<i class="fa-solid ${icon} me-2"></i>${file.name} <small style="color:var(--gray-mid)">(${sizeMb} Mo)</small>`;
    }
  }

  // ── Validation KYC avant soumission ────────────────────────────────────────
  document.getElementById('kycForm')?.addEventListener('submit', function(e) {
    const required = ['kyc_identite', 'kyc_domicile', 'kyc_propriete'];
    let ok = true;
    required.forEach(id => {
      const el = document.getElementById(id);
      if (!el?.files?.length) {
        el.closest('.kyc-upload-zone').style.borderColor = 'var(--accent)';
        ok = false;
      }
    });
    if (!ok) {
      e.preventDefault();
      alert('Veuillez télécharger les 3 documents obligatoires (identité, domicile, propriété).');
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    // Initialiser le rôle selon le radio coché par défaut
    const checked = document.querySelector('input[name="role_choice"]:checked');
    selectRole(checked?.value === 'locataire' ? 'loc' : 'prop');

    // Intercepter la soumission du formulaire via Entrée (bug principal)
    document.getElementById('regForm')?.addEventListener('submit', function(e) {
      if (currentRole !== 'locataire') {
        e.preventDefault();
        handleStep2Submit();
      }
    });

    // Si erreurs Symfony → aller à l'étape 2 automatiquement
    const hasErrors = document.querySelectorAll('.field ul li').length > 0
      || document.querySelectorAll('.global-errors li').length > 0;
    if (hasErrors) goStep(2);
  });
</script>

{% endblock %}
