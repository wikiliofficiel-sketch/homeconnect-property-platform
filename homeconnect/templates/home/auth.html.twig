<script>
    // ─── Tab switching ───
    function switchTab(tab) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.auth-panel').forEach(p => p.classList.remove('active'));
        document.getElementById('tab-' + tab).classList.add('active');
        document.getElementById('panel-' + tab).classList.add('active');
        hideForgot();
    }

    // ─── Role card selection ───
    function selectRole(radio) {
        document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
        radio.closest('.role-card').classList.add('selected');
        
        // Update all potential role inputs (manual or Symfony-generated)
        const inputs = document.querySelectorAll('input[name="role"], input[name*="role"]');
        inputs.forEach(inp => {
            if (inp.type === 'hidden' || inp.type === 'text') {
                inp.value = radio.value;
            }
        });
    }

    // ─── Multi-step register ───
    function goStep(n) {
        for (let i = 1; i <= 3; i++) {
            const el = document.getElementById('reg-step-' + i);
            if (el) el.style.display = i === n ? 'block' : 'none';

            const dot = document.getElementById('sdot-' + i);
            if (dot) {
                dot.classList.remove('active', 'done');
                if (i < n) dot.classList.add('done'), dot.innerHTML = '<i class="fa-solid fa-check" style="font-size:0.6rem;"></i>';
                else if (i === n) dot.classList.add('active'), dot.textContent = i;
                else dot.textContent = i;
            }

            if (i < 3) {
                const line = document.getElementById('sline-' + i);
                if (line) line.classList.toggle('done', i < n);
            }
        }
    }

    // ─── Forgot password ───
    function showForgot() {
        document.getElementById('login-form-view').style.display = 'none';
        const fp = document.getElementById('forgot-view');
        fp.classList.add('active');
    }

    function hideForgot() {
        document.getElementById('login-form-view').style.display = 'block';
        const fp = document.getElementById('forgot-view');
        fp.classList.remove('active');
    }

    // ─── Toggle password visibility ───
    function togglePw(id, btn) {
        const input = document.getElementById(id);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    // ─── Password strength ───
    function checkStrength(val) {
        const bars = ['pb1','pb2','pb3','pb4'];
        const label = document.getElementById('pw-label');
        let score = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        bars.forEach((b, i) => {
            const el = document.getElementById(b);
            el.className = 'pw-bar';
            if (i < score) {
                if (score <= 1) el.classList.add('weak');
                else if (score <= 2) el.classList.add('medium');
                else el.classList.add('strong');
            }
        });

        const labels = ['', 'Faible', 'Moyen', 'Bon', 'Excellent'];
        const colors = ['', '#EF4444', '#F59E0B', 'var(--wine)', 'var(--success)'];
        label.textContent = val.length ? labels[score] || 'Excellent' : 'Force du mot de passe';
        label.style.color = val.length ? colors[score] : 'var(--gray-mid)';
    }

    // ─── OTP code inputs ───
    function moveNext(input, idx) {
        input.value = input.value.replace(/[^0-9]/g, '');
        const inputs = document.querySelectorAll('.code-input');
        if (input.value && idx < inputs.length - 1) inputs[idx + 1].focus();
    }

    document.querySelectorAll('.code-input').forEach((inp, idx) => {
        inp.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !inp.value && idx > 0) {
                document.querySelectorAll('.code-input')[idx - 1].focus();
            }
        });
        inp.addEventListener('paste', (e) => {
            const data = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g,'').split('');
            document.querySelectorAll('.code-input').forEach((ci, i) => { if (data[i]) ci.value = data[i]; });
            e.preventDefault();
        });
    });

    function verifyCode() {
        const code = [...document.querySelectorAll('.code-input')].map(i => i.value).join('');
        if (code.length < 6) {
            document.querySelectorAll('.code-input').forEach(i => { i.style.borderColor = 'var(--error)'; });
            return;
        }
        document.querySelectorAll('.code-input').forEach(i => { i.style.borderColor = 'var(--success)'; });
        // Submit form or redirect
        document.getElementById('registerForm').submit();
    }

    function resendCode(e) {
        e.preventDefault();
        const link = e.target;
        link.textContent = 'Envoyé !';
        link.style.color = 'var(--success)';
        setTimeout(() => { link.textContent = 'Renvoyer'; link.style.color = 'var(--wine)'; }, 3000);
    }

    // ─── Nav scroll ───
    window.addEventListener('scroll', () => {
        const top = document.querySelector('.topbar');
        if (top) top.style.boxShadow = window.scrollY > 5 ? '0 4px 20px rgba(123,29,46,0.08)' : 'none';
    });
</script>

</body>
</html>
